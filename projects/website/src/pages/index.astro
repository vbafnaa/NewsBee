---
const apiUrl = import.meta.env.PUBLIC_API_URL || "http://127.0.0.1:8000";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Newsbee</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,400&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#edition">Skip to this week's stories</a>
    <main data-api-url={apiUrl}>
      <header class="masthead">
        <div class="ears">
          <span>Your community, this week</span>
          <div class="picker">
            <button id="edition-toggle" type="button" aria-expanded="false"
              aria-controls="edition-picker" disabled>
              <span id="selected-location">Change edition</span>
              <span class="chevron" aria-hidden="true"></span>
            </button>
            <div id="edition-picker" hidden>
              <p class="picker-heading">Choose your edition</p>
              <div id="onboarded-editions" aria-label="Available editions"></div>
              <label for="location">Find another town</label>
              <div class="location-field">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.5" aria-hidden="true">
                  <circle cx="10.5" cy="10.5" r="6.5" />
                  <path d="m15.5 15.5 5 5" />
                </svg>
                <input id="location" type="text" role="combobox" aria-autocomplete="list"
                  aria-expanded="false" aria-controls="location-options" aria-describedby="location-help"
                  placeholder="Town or city, ST" autocomplete="off" maxlength="80" disabled />
                <ul id="location-options" role="listbox" aria-label="Locations" hidden></ul>
              </div>
              <p id="location-help" aria-live="polite">Search US towns, e.g. Seattle, WA.</p>
            </div>
          </div>
        </div>
        <p class="title">Newsbee</p>
        <p class="subtitle" id="edition-name">Community News</p>
        <div class="dateline">
          <span id="edition-week">&nbsp;</span>
          <span id="edition-published">&nbsp;</span>
        </div>
      </header>
      <p id="edition-status" role="status">Loading locations...</p>
      <button id="retry" type="button" hidden>Try again</button>
      <section id="expansion" aria-labelledby="expansion-title" hidden>
        <p class="eyebrow">Your town deserves its own front page</p>
        <h2 id="expansion-title"></h2>
        <p>Every community has stories worth telling. Help bring local events, civic updates,
          and a little more connection to yours.</p>
        <form id="expansion-form">
          <label for="signup-email">Your email</label>
          <input id="signup-email" name="email" type="email" autocomplete="email" maxlength="254" required />
          <button type="submit">Help bring Newsbee here</button>
          <p class="signup-note">Join the interest list for this town. Your email and requested town
            are saved locally for this prototype; no emails are sent automatically.</p>
        </form>
        <p id="signup-status" role="status"></p>
      </section>
      <article id="edition" aria-label="Edition" hidden>
        <p id="edition-freshness" role="status"></p>
        <aside id="corrections" aria-label="Corrections" hidden></aside>
        <details class="coverage">
          <summary>About this edition and its sources</summary>
          <ul id="edition-coverage"></ul>
        </details>
        <h2 id="edition-headline"></h2>
        <p id="edition-intro" class="deck"></p>
        <div id="edition-lead"></div>
        <div id="edition-items" class="columns"></div>
        <footer>
          <p id="edition-window"></p>
          <p>Compiled automatically from library listings and public meeting records, not independent reporting. Check the original source for changes before attending.</p>
        </footer>
      </article>
    </main>
    <script>
      type Listing = { location_id: string; location_name: string; edition_id: string | null };
      type Town = { id: string; name: string };
      type Item = {
        story_id: string | null;
        headline: string;
        blurb: string;
        when_where: string;
        source_url: string | null;
        rank: number | null;
        kind: "event" | "meeting_preview" | "meeting_outcome";
        source_name: string;
      };
      type Edition = {
        headline: string;
        intro: string;
        window_start: string;
        window_end: string;
        published_at: number;
        items: Item[];
        coverage: string[];
        corrections: { reason: string; created_at: number }[];
      };

      const main = document.querySelector("main")!;
      const api = main.dataset.apiUrl;
      const input = document.querySelector<HTMLInputElement>("#location")!;
      const options = document.querySelector<HTMLUListElement>("#location-options")!;
      const help = document.querySelector<HTMLParagraphElement>("#location-help")!;
      const picker = document.querySelector<HTMLElement>(".picker")!;
      const pickerPanel = document.querySelector<HTMLDivElement>("#edition-picker")!;
      const pickerToggle = document.querySelector<HTMLButtonElement>("#edition-toggle")!;
      const selectedLabel = document.querySelector<HTMLSpanElement>("#selected-location")!;
      const onboarded = document.querySelector<HTMLDivElement>("#onboarded-editions")!;
      const status = document.querySelector<HTMLParagraphElement>("#edition-status")!;
      const article = document.querySelector<HTMLElement>("#edition")!;
      const retry = document.querySelector<HTMLButtonElement>("#retry")!;
      const expansion = document.querySelector<HTMLElement>("#expansion")!;
      const signupForm = document.querySelector<HTMLFormElement>("#expansion-form")!;
      const signupEmail = document.querySelector<HTMLInputElement>("#signup-email")!;
      const signupButton = signupForm.querySelector<HTMLButtonElement>("button")!;
      const signupStatus = document.querySelector<HTMLParagraphElement>("#signup-status")!;
      const listings = new Map<string, Listing>();
      let selected: Town | undefined;
      let candidates: Town[] = [];
      let active = -1;
      let searchVersion = 0;
      let searchTimer: ReturnType<typeof setTimeout>;

      const text = (tag: string, value: string, className?: string) => {
        const node = document.createElement(tag);
        node.textContent = value;
        if (className) node.className = className;
        return node;
      };
      const failure = (error: unknown) => (error instanceof Error ? error.message : String(error));
      const place = (name: string) => name.replace(/,\s*[A-Z]{2}$/, "");
      const day = (iso: string, options: Intl.DateTimeFormatOptions) =>
        new Date(`${iso}T12:00:00`).toLocaleDateString("en-US", options);

      async function getJson(path: string, init?: RequestInit) {
        const response = await fetch(`${api}${path}`, {
          ...init, signal: AbortSignal.timeout(5000),
        });
        if (!response.ok) throw new Error(`API returned HTTP ${response.status}`);
        return response.json();
      }

      const same = (a: string, b: string) =>
        a.toLowerCase().replace(/[^a-z0-9]/g, "") === b.toLowerCase().replace(/[^a-z0-9]/g, "");

      function story(item: Item, lead: boolean, repeatsFront = false) {
        const section = document.createElement("section");
        section.className = lead ? `story lead${repeatsFront ? " repeats-front" : ""}` : "story";
        if (item.story_id) section.id = `story-${item.story_id}`;
        section.append(text("h3", item.headline), text("p", item.blurb, "blurb"));
        section.append(text("p", item.when_where, "when-where"));
        const labels = {
          event: "Library event",
          meeting_preview: "Upcoming public meeting",
          meeting_outcome: "Recorded meeting outcome",
        };
        section.append(text("p", `${labels[item.kind]} · Source: ${item.source_name}`, "attribution"));
        if (item.source_url?.startsWith("https://")) {
          const link = text("a", "Original source") as HTMLAnchorElement;
          link.href = item.source_url;
          link.rel = "noreferrer";
          section.append(link);
        }
        return section;
      }

      function masthead(listing: Listing | undefined, edition?: Edition) {
        document.querySelector("#edition-name")!.textContent = listing
          ? `The ${place(listing.location_name)} Edition`
          : "Community News";
        document.querySelector("#edition-week")!.textContent = edition
          ? `Week of ${day(edition.window_start, { month: "short", day: "numeric" })} \u2013 ${day(
              edition.window_end,
              { month: "short", day: "numeric", year: "numeric" },
            )}`
          : "\u00a0";
        document.querySelector("#edition-published")!.textContent = edition
          ? `Published ${new Date(edition.published_at * 1000).toLocaleDateString("en-US", {
              weekday: "long",
              month: "long",
              day: "numeric",
            })}`
          : "\u00a0";
      }

      function closeOptions() {
        clearTimeout(searchTimer);
        searchVersion++;
        options.hidden = true;
        input.setAttribute("aria-expanded", "false");
        input.removeAttribute("aria-activedescendant");
        active = -1;
      }

      function closePicker(returnFocus = false) {
        closeOptions();
        pickerPanel.hidden = true;
        pickerToggle.setAttribute("aria-expanded", "false");
        if (returnFocus) pickerToggle.focus();
      }

      pickerToggle.addEventListener("click", () => {
        if (!pickerPanel.hidden) {
          closePicker();
          return;
        }
        input.value = "";
        help.textContent = "Search US towns, e.g. Seattle, WA.";
        pickerPanel.hidden = false;
        pickerToggle.setAttribute("aria-expanded", "true");
        const current = onboarded.querySelector<HTMLButtonElement>('[aria-current="true"]');
        (current ?? onboarded.querySelector<HTMLButtonElement>("button") ?? input).focus();
      });
      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !picker.contains(event.target)) closePicker();
      });
      picker.addEventListener("focusout", (event) => {
        if (!(event.relatedTarget instanceof Node) || !picker.contains(event.relatedTarget)) {
          closePicker();
        }
      });
      picker.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          closePicker(true);
        }
      });

      function highlight(index: number) {
        active = index;
        Array.from(options.children).forEach((option, i) =>
          option.setAttribute("aria-selected", String(i === active)),
        );
        const option = options.children[active];
        if (option) {
          input.setAttribute("aria-activedescendant", option.id);
          option.scrollIntoView({ block: "nearest" });
        }
      }

      async function searchTowns() {
        closeOptions();
        const query = input.value.trim();
        if (query.split(",")[0].trim().length < 2) {
          help.textContent = "Type at least two letters. Add a state, like Seattle, WA.";
          return;
        }
        const version = searchVersion;
        help.textContent = "Searching towns...";
        try {
          const data = await getJson(`/api/locations/search?q=${encodeURIComponent(query)}`);
          if (version !== searchVersion) return;
          candidates = data.results as Town[];
          options.replaceChildren(...candidates.map((town, index) => {
            const option = text("li", town.name);
            option.id = `location-option-${index}`;
            option.setAttribute("role", "option");
            option.setAttribute("aria-selected", "false");
            option.addEventListener("mousedown", (event) => event.preventDefault());
            option.addEventListener("click", () => choose(town));
            return option;
          }));
          options.hidden = candidates.length === 0;
          input.setAttribute("aria-expanded", String(candidates.length > 0));
          help.textContent = candidates.length
            ? `${candidates.length} towns found. Use arrow keys and Enter, or select a town.`
            : "No matching towns in our US library directory. Try a nearby town or add a state.";
        } catch (error) {
          if (version === searchVersion) help.textContent = `Location search unavailable: ${failure(error)}`;
        }
      }

      async function choose(town: Town, updateUrl = true) {
        const wasOpen = !pickerPanel.hidden;
        closePicker(wasOpen);
        selected = town;
        input.value = "";
        selectedLabel.textContent = town.name;
        pickerToggle.setAttribute("aria-label", `Change edition: ${town.name}`);
        onboarded.querySelectorAll<HTMLButtonElement>("button").forEach((button) =>
          button.setAttribute("aria-current", String(button.dataset.locationId === town.id)),
        );
        if (updateUrl) {
          const url = new URL(window.location.href);
          url.searchParams.set("location", town.id);
          history.replaceState(null, "", url);
        }
        await show(town);
      }

      input.addEventListener("input", () => {
        closeOptions();
        searchTimer = setTimeout(searchTowns, 250);
      });
      input.addEventListener("focus", () => {
        input.select();
        searchTowns();
      });
      input.addEventListener("blur", () => {
        closeOptions();
      });
      input.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeOptions();
        } else if (!options.hidden && ["ArrowDown", "ArrowUp"].includes(event.key)) {
          event.preventDefault();
          const next = active < 0
            ? (event.key === "ArrowDown" ? 0 : candidates.length - 1)
            : (active + (event.key === "ArrowDown" ? 1 : -1) + candidates.length) % candidates.length;
          highlight(next);
        } else if (event.key === "Enter") {
          event.preventDefault();
          if (!options.hidden && active >= 0) choose(candidates[active]);
          else help.textContent = "Select a town from the suggestions.";
        }
      });

      signupForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        const town = selected;
        if (!town || expansion.hidden) return;
        signupButton.disabled = true;
        signupStatus.textContent = "Saving your interest...";
        try {
          await getJson(`/api/locations/${encodeURIComponent(town.id)}/interest`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: signupEmail.value.trim() }),
          });
          if (selected?.id !== town.id) return;
          signupStatus.textContent = `You're on the interest list for ${town.name}. Thanks for helping Newsbee grow!`;
          signupForm.reset();
        } catch (error) {
          if (selected?.id === town.id) signupStatus.textContent = `Signup unavailable: ${failure(error)}. Please try again.`;
        } finally {
          if (selected?.id === town.id) signupButton.disabled = false;
        }
      });

      async function show(town: Town) {
        article.hidden = true;
        retry.hidden = true;
        expansion.hidden = true;
        signupStatus.textContent = "";
        signupForm.reset();
        signupButton.disabled = false;
        const locationId = town.id;
        const listing = listings.get(town.id);
        masthead(listing);
        if (!listing) {
          document.querySelector("#expansion-title")!.textContent =
            `We're not in ${place(town.name)} yet. Let's change that.`;
          status.textContent = "";
          expansion.hidden = false;
          return;
        }
        if (!listing.edition_id) {
          status.textContent = "No edition yet.";
          return;
        }
        status.textContent = "Loading edition...";
        try {
          const edition: Edition = await getJson(`/api/editions/${encodeURIComponent(locationId)}`);
          if (selected?.id !== locationId) return;
          masthead(listing, edition);
          document.querySelector("#edition-headline")!.textContent = edition.headline;
          document.querySelector("#edition-intro")!.textContent = edition.intro;
          document.querySelector("#edition-window")!.textContent =
            `Upcoming listings: ${edition.window_start} to ${edition.window_end}. Meeting outcomes may cover the preceding week.`;
          const now = new Date();
          const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
          document.querySelector("#edition-freshness")!.textContent =
            edition.window_end < today ? "Past edition: these listings may no longer be current." : "";
          document.querySelector("#edition-coverage")!.replaceChildren(
            ...edition.coverage.map((message) => text("li", message)),
          );
          const corrections = document.querySelector<HTMLElement>("#corrections")!;
          corrections.hidden = edition.corrections.length === 0;
          corrections.replaceChildren(
            ...edition.corrections.map((notice) =>
              text("p", `Correction (${new Date(notice.created_at * 1000).toLocaleDateString("en-US")}): ${notice.reason}`),
            ),
          );
          const items = edition.items;
          const ranked = items.filter((item) => item.rank !== null);
          const lead = ranked.length
            ? ranked.reduce((best, item) => (item.rank! < best.rank! ? item : best))
            : items[0];
          document.querySelector("#edition-lead")!.replaceChildren(
            ...(lead ? [story(lead, true, same(lead.headline, edition.headline))] : []),
          );
          document
            .querySelector("#edition-items")!
            .replaceChildren(...items.filter((item) => item !== lead).map((item) => story(item, false)));
          article.hidden = false;
          status.textContent = "";
        } catch (error) {
          if (selected?.id !== locationId) return;
          status.textContent = `Edition unavailable: ${failure(error)}`;
          retry.hidden = false;
        }
      }
      retry.addEventListener("click", () => {
        if (selected && listings.has(selected.id)) show(selected);
        else window.location.reload();
      });

      try {
        const data = await getJson("/api/editions");
        if (!Array.isArray(data.locations)) throw new Error("Unsupported editions contract");
        for (const listing of data.locations as Listing[]) {
          listings.set(listing.location_id, listing);
          const button = text("button", listing.location_name) as HTMLButtonElement;
          button.type = "button";
          button.dataset.locationId = listing.location_id;
          button.addEventListener("click", () => choose({
            id: listing.location_id, name: listing.location_name,
          }));
          onboarded.append(button);
        }
        const requested = new URLSearchParams(location.search).get("location");
        const listing = requested ? listings.get(requested) : data.locations[0] as Listing | undefined;
        if (listing) {
          await choose({ id: listing.location_id, name: listing.location_name }, false);
        } else if (requested) {
          try {
            const town = await getJson(`/api/locations/${encodeURIComponent(requested)}`);
            await choose(town, false);
          } catch (error) {
            status.textContent = `Location unavailable: ${failure(error)}. Choose a town from Change edition.`;
          }
        } else {
          status.textContent = "Find your community. Open Change edition to search for your town.";
        }
        input.disabled = false;
        pickerToggle.disabled = false;
      } catch (error) {
        status.textContent = `Editions unavailable: ${failure(error)}`;
        retry.hidden = false;
      }
    </script>
    <style is:global>
      @font-face {
        font-family: "Chomsky";
        src: url("/fonts/Chomsky.otf") format("opentype");
        font-display: swap;
      }
      :root {
        --paper: #f5f0e4;
        --ink: #1c1a17;
        --muted: #5b554b;
        --rule: #2b2823;
        --accent: #7a1f1f;
        --serif: "Libre Caslon Text", Georgia, "Times New Roman", serif;
        --display: "Playfair Display", Georgia, serif;
      }
      * { box-sizing: border-box; }
      .skip-link { position: absolute; left: -10000px; }
      .skip-link:focus { position: static; padding: 0.5rem; background: white; }
      :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
      body {
        margin: 0;
        background: #d9d2c3;
        color: var(--ink);
        font: 17px/1.6 var(--serif);
      }
      main {
        max-width: 68rem;
        margin: 2rem auto;
        padding: 1.5rem 2.5rem 2.5rem;
        background: var(--paper);
        box-shadow: 0 1px 3px rgb(0 0 0 / 0.15), 0 12px 32px rgb(0 0 0 / 0.12);
      }
      .masthead { text-align: center; border-bottom: 4px double var(--rule); }
      .ears {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        font: italic 0.8rem var(--serif);
        color: var(--muted);
        border-bottom: 1px solid var(--rule);
        padding-bottom: 0.4rem;
      }
      .title {
        margin: 0.6rem 0 0;
        font: 5.5rem/1 "Chomsky", var(--display);
        letter-spacing: 0.02em;
      }
      .subtitle {
        margin: 0.3rem 0 0.8rem;
        font: italic 1.15rem var(--display);
        color: var(--accent);
      }
      .dateline {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 1rem;
        border-top: 1px solid var(--rule);
        padding: 0.45rem 0;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }
      .dateline > :first-child { text-align: left; }
      .dateline > :last-child { text-align: right; }
      .picker { position: relative; text-align: left; font-style: normal; }
      #edition-toggle {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        min-height: 2.25rem;
        max-width: 18rem;
        padding: 0.25rem 0;
        border: 0;
        background: transparent;
        color: var(--accent);
        font: 0.8rem/1.4 var(--serif);
        cursor: pointer;
      }
      #edition-toggle:hover { text-decoration: underline; text-underline-offset: 0.2rem; }
      #edition-toggle:focus-visible, #onboarded-editions button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }
      #edition-toggle:disabled { opacity: 0.6; cursor: wait; }
      .chevron {
        width: 0.4rem;
        height: 0.4rem;
        flex-shrink: 0;
        border-right: 1px solid currentColor;
        border-bottom: 1px solid currentColor;
        transform: rotate(45deg) translateY(-2px);
      }
      #edition-toggle[aria-expanded="true"] .chevron { transform: rotate(225deg); }
      #edition-picker {
        position: absolute;
        z-index: 3;
        top: calc(100% + 0.5rem);
        right: 0;
        width: min(19rem, calc(100vw - 2rem));
        max-height: min(34rem, 75vh);
        overflow-y: auto;
        padding: 1rem;
        background: var(--paper);
        border: 1px solid #a69a85;
        border-top: 2px solid var(--accent);
        box-shadow: 0 6px 18px rgb(28 26 23 / 0.15);
      }
      .picker-heading {
        margin: 0 0 0.5rem;
        font: italic 1.1rem/1.4 var(--display);
        color: var(--ink);
      }
      #onboarded-editions { max-height: 12rem; overflow-y: auto; }
      #onboarded-editions:not(:empty) { margin-bottom: 1rem; border-bottom: 1px solid #c9c0ae; }
      #onboarded-editions button {
        display: block;
        width: 100%;
        padding: 0.6rem 0.4rem;
        border: 0;
        background: transparent;
        color: var(--ink);
        font: 0.9rem/1.4 var(--serif);
        text-align: left;
        cursor: pointer;
      }
      #onboarded-editions button:hover { background: #e8dfcd; }
      #onboarded-editions [aria-current="true"] { color: var(--accent); font-weight: bold; }
      #onboarded-editions [aria-current="true"]::after { content: " \2713"; }
      .picker label {
        display: block;
        margin-bottom: 0.5rem;
        font: 700 0.72rem/1.4 var(--serif);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
      }
      .location-field {
        position: relative;
        display: flex;
        align-items: center;
        background: #fffaf0;
        border: 1px solid #a69a85;
        border-bottom: 2px solid var(--rule);
        border-radius: 2px;
        transition: border-color 150ms, box-shadow 150ms;
      }
      .location-field:focus-within {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgb(122 31 31 / 0.12);
      }
      .search-icon { flex: 0 0 1rem; width: 1rem; height: 1rem; margin-left: 0.6rem; color: var(--accent); }
      .picker input {
        min-width: 0;
        width: 100%;
        font: 0.9rem/1.5 var(--serif);
        background: transparent;
        color: var(--ink);
        border: 0;
        padding: 0.5rem 0.6rem;
      }
      .picker input:focus { outline: none; }
      .picker input::placeholder { color: #746b5b; font-style: italic; }
      .picker input:disabled { cursor: wait; opacity: 0.65; }
      #location-help {
