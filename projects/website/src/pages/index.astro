---
const apiUrl = import.meta.env.PUBLIC_API_URL || "http://127.0.0.1:8000";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Newsbee</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,400&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&display=swap"
    />
  </head>
  <body>
    <main data-api-url={apiUrl}>
      <header class="masthead">
        <div class="ears">
          <span>Your community, this week</span>
          <span>Free &middot; Local &middot; Independent</span>
        </div>
        <p class="title">Newsbee</p>
        <p class="subtitle" id="edition-name">Community News</p>
        <div class="dateline">
          <span id="edition-week">&nbsp;</span>
          <span class="picker">
            <label for="location">Location</label>
            <select id="location" disabled></select>
          </span>
          <span id="edition-published">&nbsp;</span>
        </div>
      </header>
      <p id="edition-status" role="status">Loading locations...</p>
      <article id="edition" aria-label="Edition" hidden>
        <h2 id="edition-headline"></h2>
        <p id="edition-intro" class="deck"></p>
        <div id="edition-lead"></div>
        <div id="edition-items" class="columns"></div>
        <footer>
          <p id="edition-window"></p>
          <p>Compiled automatically from local listings. Check the original event before you go.</p>
        </footer>
      </article>
    </main>
    <script>
      type Listing = { location_id: string; location_name: string; edition_id: string | null };
      type Item = {
        headline: string;
        blurb: string;
        when_where: string;
        source_url: string | null;
        rank: number | null;
      };

      const main = document.querySelector("main")!;
      const api = main.dataset.apiUrl;
      const select = document.querySelector<HTMLSelectElement>("#location")!;
      const status = document.querySelector<HTMLParagraphElement>("#edition-status")!;
      const article = document.querySelector<HTMLElement>("#edition")!;
      const listings = new Map<string, Listing>();

      const text = (tag: string, value: string, className?: string) => {
        const node = document.createElement(tag);
        node.textContent = value;
        if (className) node.className = className;
        return node;
      };
      const failure = (error: unknown) => (error instanceof Error ? error.message : String(error));
      const place = (name: string) => name.replace(/,\s*[A-Z]{2}$/, "");
      const day = (iso: string, options: Intl.DateTimeFormatOptions) =>
        new Date(`${iso}T12:00:00`).toLocaleDateString("en-US", options);

      async function getJson(path: string) {
        const response = await fetch(`${api}${path}`, { signal: AbortSignal.timeout(5000) });
        if (!response.ok) throw new Error(`API returned HTTP ${response.status}`);
        return response.json();
      }

      const same = (a: string, b: string) =>
        a.toLowerCase().replace(/[^a-z0-9]/g, "") === b.toLowerCase().replace(/[^a-z0-9]/g, "");

      function story(item: Item, lead: boolean, repeatsFront = false) {
        const section = document.createElement("section");
        section.className = lead ? `story lead${repeatsFront ? " repeats-front" : ""}` : "story";
        section.append(text("h3", item.headline), text("p", item.blurb, "blurb"));
        section.append(text("p", item.when_where, "when-where"));
        if (item.source_url?.startsWith("https://")) {
          const link = text("a", "Original event") as HTMLAnchorElement;
          link.href = item.source_url;
          link.rel = "noreferrer";
          section.append(link);
        }
        return section;
      }

      function masthead(listing: Listing | undefined, edition?: any) {
        document.querySelector("#edition-name")!.textContent = listing
          ? `The ${place(listing.location_name)} Edition`
          : "Community News";
        document.querySelector("#edition-week")!.textContent = edition
          ? `Week of ${day(edition.window_start, { month: "short", day: "numeric" })} \u2013 ${day(
              edition.window_end,
              { month: "short", day: "numeric", year: "numeric" },
            )}`
          : "\u00a0";
        document.querySelector("#edition-published")!.textContent = edition
          ? `Published ${new Date(edition.published_at * 1000).toLocaleDateString("en-US", {
              weekday: "long",
              month: "long",
              day: "numeric",
            })}`
          : "\u00a0";
      }

      async function show(locationId: string) {
        article.hidden = true;
        const listing = listings.get(locationId);
        masthead(listing);
        if (!listing?.edition_id) {
          status.textContent = "No edition yet.";
          return;
        }
        status.textContent = "Loading edition...";
        try {
          const edition = await getJson(`/api/editions/${encodeURIComponent(locationId)}`);
          if (select.value !== locationId) return;
          masthead(listing, edition);
          document.querySelector("#edition-headline")!.textContent = edition.headline;
          document.querySelector("#edition-intro")!.textContent = edition.intro;
          document.querySelector("#edition-window")!.textContent =
            `Events from ${edition.window_start} to ${edition.window_end}.`;
          const items = edition.items as Item[];
          const ranked = items.filter((item) => item.rank !== null);
          const lead = ranked.length
            ? ranked.reduce((best, item) => (item.rank! < best.rank! ? item : best))
            : items[0];
          document.querySelector("#edition-lead")!.replaceChildren(
            ...(lead ? [story(lead, true, same(lead.headline, edition.headline))] : []),
          );
          document
            .querySelector("#edition-items")!
            .replaceChildren(...items.filter((item) => item !== lead).map((item) => story(item, false)));
          article.hidden = false;
          status.textContent = "";
        } catch (error) {
          status.textContent = `Edition unavailable: ${failure(error)}`;
        }
      }

      try {
        const data = await getJson("/api/editions");
        if (!Array.isArray(data.locations)) throw new Error("Unsupported editions contract");
        for (const listing of data.locations as Listing[]) {
          listings.set(listing.location_id, listing);
          const option = text("option", listing.location_name) as HTMLOptionElement;
          option.value = listing.location_id;
          select.append(option);
        }
        if (listings.size === 0) {
          status.textContent = "No locations onboarded yet.";
        } else {
          const requested = new URLSearchParams(location.search).get("location");
          if (requested && listings.has(requested)) select.value = requested;
          select.disabled = false;
          select.addEventListener("change", () => {
            history.replaceState(null, "", `?location=${encodeURIComponent(select.value)}`);
            show(select.value);
          });
          await show(select.value);
        }
      } catch (error) {
        status.textContent = `Editions unavailable: ${failure(error)}`;
      }
    </script>
    <style is:global>
      @font-face {
        font-family: "Chomsky";
        src: url("/fonts/Chomsky.otf") format("opentype");
        font-display: swap;
      }
      :root {
        --paper: #f5f0e4;
        --ink: #1c1a17;
        --muted: #5b554b;
        --rule: #2b2823;
        --accent: #7a1f1f;
        --serif: "Libre Caslon Text", Georgia, "Times New Roman", serif;
        --display: "Playfair Display", Georgia, serif;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: #d9d2c3;
        color: var(--ink);
        font: 17px/1.6 var(--serif);
      }
      main {
        max-width: 68rem;
        margin: 2rem auto;
        padding: 1.5rem 2.5rem 2.5rem;
        background: var(--paper);
        box-shadow: 0 1px 3px rgb(0 0 0 / 0.15), 0 12px 32px rgb(0 0 0 / 0.12);
      }
      .masthead { text-align: center; border-bottom: 4px double var(--rule); }
      .ears {
        display: flex;
        justify-content: space-between;
        font: italic 0.8rem var(--serif);
        color: var(--muted);
        border-bottom: 1px solid var(--rule);
        padding-bottom: 0.4rem;
      }
      .title {
        margin: 0.6rem 0 0;
        font: 5.5rem/1 "Chomsky", var(--display);
        letter-spacing: 0.02em;
      }
      .subtitle {
        margin: 0.3rem 0 0.8rem;
        font: italic 1.15rem var(--display);
        color: var(--accent);
      }
      .dateline {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
        border-top: 1px solid var(--rule);
        padding: 0.45rem 0;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }
      .dateline > :first-child { text-align: left; }
      .dateline > :last-child { text-align: right; }
      .picker label { margin-right: 0.4rem; }
      .picker select {
        font: inherit;
        letter-spacing: 0.05em;
        background: transparent;
        color: var(--ink);
        border: 1px solid var(--rule);
        padding: 0.15rem 0.4rem;
      }
      #edition-status { text-align: center; font-style: italic; color: var(--muted); }
      #edition-status:empty { display: none; }
      #edition-headline {
        margin: 1.5rem 0 0.4rem;
        text-align: center;
        font: 900 3.4rem/1.05 var(--display);
        letter-spacing: -0.01em;
      }
      .deck {
        max-width: 42rem;
        margin: 0 auto 1.5rem;
        text-align: center;
        font: italic 1.2rem/1.5 var(--display);
        color: var(--muted);
      }
      .story h3 { font: 700 1.35rem/1.2 var(--display); margin: 0 0 0.5rem; }
      .story .blurb { margin: 0 0 0.6rem; text-align: justify; hyphens: auto; }
      .when-where {
        margin: 0 0 0.5rem;
        font-size: 0.85rem;
        border-top: 1px dotted var(--muted);
        border-bottom: 1px dotted var(--muted);
        padding: 0.3rem 0;
      }
      .story a {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--accent);
        text-decoration: none;
      }
      .story a::after { content: " \2192"; }
      .story a:hover { text-decoration: underline; }
      .lead {
        border-top: 2px solid var(--rule);
        border-bottom: 2px solid var(--rule);
        padding: 1.2rem 0;
        margin-bottom: 1.5rem;
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        column-gap: 2rem;
      }
      .lead h3 { grid-row: span 3; font-size: 2.3rem; line-height: 1.1; margin: 0; }
      .lead .blurb { font-size: 1.15rem; }
      .repeats-front { display: block; column-count: 2; column-gap: 2rem; column-rule: 1px solid #c9c0ae; }
      .repeats-front h3 {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
      }
      .repeats-front .when-where, .repeats-front a { break-inside: avoid; display: block; }
      .lead .blurb::first-letter {
        float: left;
        font: 900 3.6rem/0.8 var(--display);
        padding: 0.3rem 0.5rem 0 0;
        color: var(--accent);
      }
      .columns {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: 0 2rem;
      }
      .columns .blurb { text-align: left; }
      .columns .story { padding: 0 0 1.5rem; border-bottom: 1px solid #c9c0ae; margin-bottom: 1.2rem; }
      footer {
        border-top: 4px double var(--rule);
        margin-top: 1rem;
        padding-top: 0.6rem;
        text-align: center;
        font: italic 0.8rem var(--serif);
        color: var(--muted);
      }
      footer p { margin: 0.2rem 0; }
      @media (max-width: 760px) {
        main { margin: 0; padding: 1rem; }
        .title { font-size: 3.4rem; }
        .ears { display: none; }
        .dateline { grid-template-columns: 1fr; text-align: center; }
        .dateline > :first-child, .dateline > :last-child { text-align: center; }
        #edition-headline { font-size: 2.2rem; }
        .lead { grid-template-columns: 1fr; }
        .repeats-front { column-count: 1; }
        .lead h3 { font-size: 1.8rem; margin-bottom: 0.6rem; }
      }
    </style>
  </body>
</html>
