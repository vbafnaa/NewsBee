{
  "$defs": {
    "CapabilityReadiness": {
      "properties": {
        "status": {
          "enum": [
            "ready",
            "unavailable",
            "not_configured",
            "not_implemented"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "status",
        "detail"
      ],
      "title": "CapabilityReadiness",
      "type": "object"
    },
    "ComponentHealth": {
      "properties": {
        "status": {
          "enum": [
            "ok",
            "unavailable",
            "not_configured"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "status",
        "detail"
      ],
      "title": "ComponentHealth",
      "type": "object"
    },
    "EditionRun": {
      "description": "One authoring run over one location snapshot. A completed run is the published edition.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "community_id": {
          "title": "Community Id",
          "type": "string"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        },
        "window_start": {
          "title": "Window Start",
          "type": "string"
        },
        "window_end": {
          "title": "Window End",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "failed",
            "completed"
          ],
          "title": "Status",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "included": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Included"
        },
        "held": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Held"
        },
        "attempted": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempted"
        },
        "not_attempted": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Attempted"
        },
        "events": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Events"
        },
        "stories": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stories"
        },
        "skipped_for_variety": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipped For Variety"
        },
        "ranked": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ranked"
        },
        "ranking_fallback_ratings": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ranking Fallback Ratings"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "front_fallback": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Front Fallback"
        },
        "email_fallback": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email Fallback"
        }
      },
      "required": [
        "id",
        "community_id",
        "window_start",
        "window_end",
        "model",
        "status",
        "error"
      ],
      "title": "EditionRun",
      "type": "object"
    },
    "EmailDelivery": {
      "description": "Email-preview delivery for one location's most recently emailed edition.",
      "properties": {
        "edition_id": {
          "title": "Edition Id",
          "type": "string"
        },
        "location_id": {
          "title": "Location Id",
          "type": "string"
        },
        "sent": {
          "default": 0,
          "title": "Sent",
          "type": "integer"
        },
        "pending": {
          "default": 0,
          "title": "Pending",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "title": "Failed",
          "type": "integer"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "edition_id",
        "location_id"
      ],
      "title": "EmailDelivery",
      "type": "object"
    },
    "IngestionRun": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "location_id": {
          "title": "Location Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "failed",
            "completed"
          ],
          "title": "Status",
          "type": "string"
        },
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "event_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Count"
        },
        "skipped_other_venues": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipped Other Venues"
        },
        "skipped_outside_window": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipped Outside Window"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "systems": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SystemIngestion"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Systems"
        }
      },
      "required": [
        "id",
        "location_id",
        "status",
        "attempts",
        "error"
      ],
      "title": "IngestionRun",
      "type": "object"
    },
    "LocationStatus": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "library_systems": {
          "title": "Library Systems",
          "type": "integer"
        },
        "websites_resolved": {
          "title": "Websites Resolved",
          "type": "integer"
        },
        "latest_ingestion": {
          "anyOf": [
            {
              "$ref": "#/$defs/IngestionRun"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "latest_edition_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Edition Id"
        },
        "latest_edition_published_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Edition Published At"
        }
      },
      "required": [
        "id",
        "name",
        "library_systems",
        "websites_resolved"
      ],
      "title": "LocationStatus",
      "type": "object"
    },
    "SystemIngestion": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "ingested",
            "no_feed",
            "unresolved_website",
            "blocked",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "feed_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feed Kind"
        },
        "event_count": {
          "default": 0,
          "title": "Event Count",
          "type": "integer"
        },
        "skipped_other_venues": {
          "default": 0,
          "title": "Skipped Other Venues",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "name",
        "status",
        "detail"
      ],
      "title": "SystemIngestion",
      "type": "object"
    }
  },
  "properties": {
    "status": {
      "enum": [
        "ok",
        "degraded"
      ],
      "title": "Status",
      "type": "string"
    },
    "components": {
      "additionalProperties": {
        "$ref": "#/$defs/ComponentHealth"
      },
      "title": "Components",
      "type": "object"
    },
    "capabilities": {
      "additionalProperties": {
        "$ref": "#/$defs/CapabilityReadiness"
      },
      "title": "Capabilities",
      "type": "object"
    },
    "latest_ingestion": {
      "anyOf": [
        {
          "$ref": "#/$defs/IngestionRun"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "locations": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/LocationStatus"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locations"
    },
    "latest_edition": {
      "anyOf": [
        {
          "$ref": "#/$defs/EditionRun"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "email_deliveries": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/EmailDelivery"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Email Deliveries"
    },
    "jobs": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Jobs"
    },
    "last_completed_job_at": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Completed Job At"
    },
    "pipelines": {
      "const": "local_ingestion_and_auto_publish",
      "default": "local_ingestion_and_auto_publish",
      "title": "Pipelines",
      "type": "string"
    },
    "publication": {
      "const": "automatic_local_only",
      "default": "automatic_local_only",
      "title": "Publication",
      "type": "string"
    }
  },
  "required": [
    "status",
    "components",
    "capabilities"
  ],
  "title": "HealthReport",
  "type": "object"
}
