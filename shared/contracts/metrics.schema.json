  "description": "Read-only operational metrics over the trailing window, for the review dashboard.",
  "properties": {
    "generated_at": {
      "title": "Generated At",
      "type": "number"
    },
    "window_days": {
      "title": "Window Days",
      "type": "integer"
    },
    "ingestion": {
      "$ref": "#/$defs/IngestionMetrics"
    },
    "editions": {
      "$ref": "#/$defs/EditionMetrics"
    },
    "email": {
      "$ref": "#/$defs/EmailMetrics"
    },
    "queue": {
      "$ref": "#/$defs/QueueMetrics"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/LocationFreshness"
      },
      "title": "Locations",
      "type": "array"
    }
  },
  "required": [
    "generated_at",
    "window_days",
    "ingestion",
    "editions",
    "email",
    "queue"
  ],
  "title": "MetricsReport",
  "type": "object"
