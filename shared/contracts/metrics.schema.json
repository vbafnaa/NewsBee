        "ranked": {
          "default": 0,
          "title": "Ranked",
          "type": "integer"
        },
        "ranking_fallback_ratings": {
          "default": 0,
          "title": "Ranking Fallback Ratings",
          "type": "integer"
        },
        "ranking_fallback_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
