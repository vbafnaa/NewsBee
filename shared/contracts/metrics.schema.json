          "title": "Kind",
          "type": "string"
        },
        "sources": {
          "default": 0,
          "title": "Sources",
          "type": "integer"
        },
        "ingested": {
          "default": 0,
          "title": "Ingested",
          "type": "integer"
        },
        "events": {
          "default": 0,
          "title": "Events",
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SourceKindMetrics",
      "type": "object"
