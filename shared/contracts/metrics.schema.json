{
  "$defs": {
    "DailyRuns": {
      "description": "Runs finished on one UTC day; `items` is events ingested or items published.",
      "properties": {
        "day": {
          "title": "Day",
          "type": "string"
        },
        "completed": {
          "default": 0,
          "title": "Completed",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "title": "Failed",
          "type": "integer"
        },
        "items": {
          "default": 0,
          "title": "Items",
          "type": "integer"
        }
      },
      "required": [
        "day"
      ],
      "title": "DailyRuns",
      "type": "object"
    },
    "EditionMetrics": {
      "properties": {
        "runs": {
          "default": 0,
