        "by_source": {
          "items": {
            "$ref": "#/$defs/SourceKindMetrics"
          },
          "title": "By Source",
          "type": "array"
        },
        "daily": {
          "items": {
            "$ref": "#/$defs/DailyRuns"
          },
          "title": "Daily",
          "type": "array"
        }
