{
  "$defs": {
    "CorrectionNotice": {
      "properties": {
        "story_id": {
          "title": "Story Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "number"
        }
      },
      "required": [
        "story_id",
        "reason",
        "created_at"
      ],
      "title": "CorrectionNotice",
      "type": "object"
    },
    "EditionItem": {
      "properties": {
        "illustration_id": { "type": "string", "enum": ["music","books","permits","community","performance","comedy","improv","trees","civic","transit","sports","games","arts","improv-prompts","theatre-curtain","theatre-tickets","theatre-stage","comedy-duo","improv-props","puppets","reception","film","volunteers","autumn-park","soccer","basketball","baseball","curling","restaurants","podcast","halloween","civic-budget","neighborhood-meeting","music-keys","event-calendar","tickets","civic-housing","civic-papers","film-reel","food-kitchen"] },
        "illustration_policy": { "type": "string", "const": "newsbee-watercolor-v1" },
        "illustration_asset_id": { "type": "string", "enum": ["music","books","permits","community","performance","comedy","improv","trees","civic","transit","sports","games","arts","improv-prompts","theatre-curtain","theatre-tickets","theatre-stage","comedy-duo","improv-props","puppets","reception","film","volunteers","autumn-park","soccer","basketball","baseball","curling","restaurants","podcast","halloween","civic-budget","neighborhood-meeting","music-keys","event-calendar","tickets","civic-housing","civic-papers","film-reel","food-kitchen","wedgwood-books","moses-lake-football"] },
        "story_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Id"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "blurb": {
          "title": "Blurb",
          "type": "string"
        },
        "when_where": {
          "title": "When Where",
          "type": "string"
        },
        "event_date": {
          "title": "Event Date",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "kind": {
          "default": "event",
          "enum": [
            "event",
            "meeting_preview",
            "meeting_outcome",
            "state_news",
            "earthquake",
            "trending_topic",
            "social_trend",
            "safety_notice",
            "housing_market",
            "development",
            "school_sports",
          "game_result",
          "home_sale",
          "building_permit",
            "weather_alert",
            "court_case",
            "local_news",
            "business_opening",
            "obituary",
            "reader_story",
            "safety_incident",
            "news_report",
            "public_record"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_name": {
          "default": "Local source",
          "title": "Source Name",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "local": {
          "default": true,
          "title": "Local",
          "type": "boolean"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id",
          "description": "Newsletter section: events, civic, schools, safety, real_estate, business, obituaries, community, weather, news"
        },
        "also_from": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Also From",
          "type": "array",
          "description": "Other sources that reported the same story"
        },
        "lead": {
          "default": false,
          "title": "Lead",
          "type": "boolean"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image",
          "description": "An approved story photo or licensed event-venue photograph; optional metadata preserves provenance"
        },
        "image_credit": {
          "type": "string",
          "maxLength": 240,
          "description": "Publisher-supplied credit, or the source's name; does not imply a reuse license"
        },
        "image_source_url": {
          "type": "string",
          "description": "The original article or licensed file page that supplied this image"
        },
        "image_alt": {
          "type": "string",
          "maxLength": 500,
          "description": "Only the publisher's supplied alternative text or image caption"
        },
        "image_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "image_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "image_role": {
          "enum": ["venue", "area", "stock"],
          "description": "Venue or permit street context, or last-resort stock for eligible neutral event activities"
        },
        "image_place": { "type": "string", "maxLength": 120 },
        "image_asset_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "image_caption": { "type": ["string", "null"], "maxLength": 500 },
        "image_date": { "type": "string", "format": "date" },
        "image_license": { "type": "string", "maxLength": 100 },
        "image_license_url": { "type": "string", "format": "uri" }
      },
      "required": [
        "headline",
        "blurb",
        "when_where",
        "event_date",
        "source_url"
      ],
      "title": "EditionItem",
      "type": "object"
    }
  },
  "properties": {
    "media_mode": { "type": "string", "enum": ["illustrated", "photos", "none"] },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "location_id": {
      "title": "Location Id",
      "type": "string"
    },
    "location_name": {
      "title": "Location Name",
      "type": "string"
    },
    "window_start": {
      "title": "Window Start",
      "type": "string"
    },
    "window_end": {
      "title": "Window End",
      "type": "string"
    },
    "published_at": {
      "title": "Published At",
      "type": "number"
    },
    "headline": {
      "title": "Headline",
      "type": "string"
    },
    "intro": {
      "title": "Intro",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/EditionItem"
      },
      "title": "Items",
      "type": "array"
    },
    "coverage": {
      "items": {
        "type": "string"
      },
      "title": "Coverage",
      "type": "array"
    },
    "corrections": {
      "items": {
        "$ref": "#/$defs/CorrectionNotice"
      },
      "title": "Corrections",
      "type": "array"
    }
  },
  "required": [
    "id",
    "location_id",
    "location_name",
    "window_start",
    "window_end",
    "published_at",
    "headline",
    "intro",
    "items"
  ],
  "title": "Edition",
  "type": "object"
}
