{
  "$defs": {
    "CorrectionNotice": {
      "properties": {
        "story_id": {
          "title": "Story Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "number"
        }
      },
      "required": [
        "story_id",
        "reason",
        "created_at"
      ],
      "title": "CorrectionNotice",
      "type": "object"
    },
    "EditionItem": {
      "properties": {
        "story_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Id"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "blurb": {
          "title": "Blurb",
          "type": "string"
        },
        "when_where": {
          "title": "When Where",
          "type": "string"
        },
        "event_date": {
          "title": "Event Date",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "kind": {
          "default": "event",
          "enum": [
            "event",
            "meeting_preview",
            "meeting_outcome",
            "state_news",
            "earthquake",
            "trending_topic",
            "social_trend",
            "safety_notice",
            "housing_market",
            "development",
            "school_sports"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_name": {
          "default": "Local source",
          "title": "Source Name",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "local": {
          "default": true,
          "title": "Local",
          "type": "boolean"
        }
      },
      "required": [
        "headline",
        "blurb",
        "when_where",
        "event_date",
        "source_url"
      ],
      "title": "EditionItem",
      "type": "object"
    },
    "CalendarEntry": {
      "description": "An upcoming event or public meeting published as source facts, without model writing.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "event_date": {
          "title": "Event Date",
          "type": "string"
        },
        "schedule_text": {
          "title": "Schedule Text",
          "type": "string"
        },
        "venue": {
          "title": "Venue",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "event",
            "meeting_preview"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "event_date",
        "schedule_text",
        "venue",
        "source_url",
        "source_name",
        "kind"
      ],
      "title": "CalendarEntry",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "location_id": {
      "title": "Location Id",
      "type": "string"
    },
    "location_name": {
      "title": "Location Name",
      "type": "string"
    },
    "window_start": {
      "title": "Window Start",
      "type": "string"
    },
    "window_end": {
      "title": "Window End",
      "type": "string"
    },
    "published_at": {
      "title": "Published At",
      "type": "number"
    },
    "headline": {
      "title": "Headline",
      "type": "string"
    },
    "intro": {
      "title": "Intro",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/EditionItem"
      },
      "title": "Items",
      "type": "array"
    },
    "coverage": {
      "items": {
        "type": "string"
      },
      "title": "Coverage",
      "type": "array"
    },
    "corrections": {
      "items": {
        "$ref": "#/$defs/CorrectionNotice"
      },
      "title": "Corrections",
      "type": "array"
    },
    "calendar": {
      "description": "Every eligible upcoming listing in the window; absent from older editions.",
      "items": {
        "$ref": "#/$defs/CalendarEntry"
      },
      "title": "Calendar",
      "type": "array"
    }
  },
  "required": [
    "id",
    "location_id",
    "location_name",
    "window_start",
    "window_end",
    "published_at",
    "headline",
    "intro",
    "items"
  ],
  "title": "Edition",
  "type": "object"
}
