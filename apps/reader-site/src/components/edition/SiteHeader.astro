---
import { sectionNavigation } from "../../lib/reader-navigation";
type TopicLink = { label: string; href: string };
interface Props {
  town: string; today: string; visible: string[]; submitHref?: string; homeHref?: string;
  homeLabel?: string; pageHref?: string; locationId?: string; subscribeHref?: string;
  subscribeLabel?: string; eventsHref?: string; archiveHref?: string;
  categoryLinks?: TopicLink[]; allStoriesHref?: string; browseHref?: string; browseLabel?: string;
}
const {
  town, today, visible, submitHref, homeHref = "#top",
  homeLabel = homeHref === "#top" ? "Newsbee, back to top" : "Newsbee, choose a neighborhood",
  pageHref = "", locationId, subscribeHref = `${pageHref}#subscribe`, subscribeLabel = "Subscribe",
  eventsHref = `${pageHref}#events`, categoryLinks, allStoriesHref,
  browseHref, browseLabel = "Browse stories",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Contextual publication links also keep private previews within their selected draft.
const archiveHref = Astro.props.archiveHref ?? (browseHref ? undefined
  : `${base}/browse${locationId ? `?location=${encodeURIComponent(locationId)}` : ""}#editions`);
const categories = categoryLinks ?? sectionNavigation(visible)
  .filter((item) => !["top-news", "events", "other-news"].includes(item.id))
  .map((item) => ({ label: item.label, href: `${pageHref}#${item.id}` }));
const sections = [
  ...(visible.includes("top-news") ? [{ label: "Top News", href: `${pageHref}#top-news` }] : []),
  ...(visible.includes("events") || Astro.props.eventsHref ? [{ label: "Events", href: eventsHref }] : []),
];
const primaryHref = allStoriesHref ?? subscribeHref;
const primaryLabel = allStoriesHref ? "All stories" : subscribeLabel;
---
<header class="masthead" id="masthead">
  <div class:list={["nb-container", "bar", { "article-header": Boolean(allStoriesHref) }]}>
    <span class="nb-label date">{today}</span>
    <a class="wordmark" href={homeHref} aria-label={homeLabel}>Newsbee</a>
    <div class="actions">
      {submitHref && <a class="nb-button nb-button-quiet" href={submitHref}>Submit an event</a>}
      <a class="nb-button nb-button-primary" href={primaryHref}>{primaryLabel}</a>
    </div>
  </div>
  <nav class="subnav" aria-label="Sections">
    <div class="nb-container subnav-row">
      <span class="nb-label town">{town}</span>
      <ul class="topics">
        {sections.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        {categories.length > 0 && <li>
          <details class="category-menu" data-category-menu>
            <summary>Categories</summary>
            <ul>{categories.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
          </details>
        </li>}
        {archiveHref && <li><a href={archiveHref}>Archive</a></li>}
        {browseHref && <li><a href={browseHref}>{browseLabel}</a></li>}
      </ul>
    </div>
  </nav>
</header>

<div class="compact" id="compact-header" aria-hidden="true" inert>
  <div class="nb-container compact-row">
    <a class="logo" href={homeHref} aria-label={homeLabel}>N</a>
    <span class="nb-label town">{town}</span>
    <ul class="topics">
      {sections.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      {categories.length > 0 && <li>
        <details class="category-menu" data-category-menu>
          <summary>Categories</summary>
          <ul>{categories.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
        </details>
      </li>}
      {archiveHref && <li><a href={archiveHref}>Archive</a></li>}
      {browseHref && <li><a href={browseHref}>{browseLabel}</a></li>}
    </ul>
    <div class="actions">
      {submitHref && <a class="nb-button nb-button-quiet" href={submitHref}>Submit an event</a>}
      <a class="nb-button nb-button-primary" href={primaryHref}>{primaryLabel}</a>
    </div>
  </div>
</div>

<script>
  const menus = [...document.querySelectorAll<HTMLDetailsElement>("[data-category-menu]")];
  for (const menu of menus) {
    menu.addEventListener("toggle", () => {
      if (menu.open) for (const other of menus) if (other !== menu) other.open = false;
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        menu.open = false;
        menu.querySelector("summary")?.focus();
        event.stopPropagation();
      }
    });
    menu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) menu.open = false;
    });
  }
  document.addEventListener("pointerdown", (event) => {
    if (event.target instanceof Node) for (const menu of menus) if (!menu.contains(event.target)) menu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const open = menus.find((menu) => menu.open);
    if (open) {
      open.open = false;
      open.querySelector("summary")?.focus();
    }
  });
  const masthead = document.getElementById("masthead");
  const compact = document.getElementById("compact-header");
  if (masthead && compact && "IntersectionObserver" in window) {
    const setHeaderHeight = () => document.documentElement.style.setProperty("--reader-header-height", `${compact.getBoundingClientRect().height}px`);
    setHeaderHeight();
    if ("ResizeObserver" in window) new ResizeObserver(setHeaderHeight).observe(compact);
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting;
      compact.classList.toggle("is-visible", show);
      compact.toggleAttribute("inert", !show);
      compact.setAttribute("aria-hidden", String(!show));
      for (const menu of menus) menu.open = false;
    }).observe(masthead);
  }
</script>

<style>
  .masthead { border-bottom: 1px solid var(--color-line); background: var(--color-surface); }
  .bar { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: var(--space-4); padding-block: var(--space-6); }
  .bar .actions { justify-self: end; }
  .wordmark { font: var(--weight-heading) var(--text-4xl)/1 var(--font-display); letter-spacing: var(--tracking-h1); color: var(--color-ink); text-decoration: none; }
  .date { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center; }
  .actions { display: flex; gap: var(--space-2); flex-shrink: 0; }
  .article-header .wordmark { grid-column: 1; grid-row: 1; justify-self: start; }
  .article-header .date { grid-column: 2; grid-row: 1; font-size: var(--text-body); font-weight: 400; letter-spacing: normal; text-transform: none; color: var(--color-ink); }
  .subnav { border-top: 1px solid var(--color-line); }
  .subnav-row { display: flex; align-items: center; gap: var(--space-6); padding-block: var(--space-2); }
  .town { color: var(--color-ink); flex-shrink: 0; }
  .topics { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1); margin: 0; padding: 0; list-style: none; min-width: 0; }
  .topics > li > a, .category-menu > summary { display: block; padding: var(--space-2) var(--space-3); font-size: var(--text-sm); color: var(--color-ink-soft); text-decoration: none; white-space: nowrap; border-radius: var(--radius-pill); cursor: pointer; transition: background-color var(--transition); }
  .topics > li > a:hover, .category-menu > summary:hover { background: var(--color-pill-gray); color: var(--color-ink); }
  .category-menu { position: relative; }
  .category-menu > summary { list-style: none; }
  .category-menu > summary::-webkit-details-marker { display: none; }
  .category-menu[open] > summary { background: var(--color-paper); }
  .category-menu > ul { position: absolute; inset: 100% auto auto 0; z-index: 12; width: max-content; min-width: 5.875rem; max-width: min(18rem, calc(100vw - 2rem)); margin: 0; padding: 0; list-style: none; background: #fffaf0; border: 1px solid var(--color-line); box-shadow: var(--shadow-sm); }
  .category-menu li a { display: block; padding: var(--space-2) var(--space-3); font-size: var(--text-sm); color: var(--color-ink-soft); text-decoration: none; overflow-wrap: anywhere; }
  .category-menu li a:hover, .category-menu li a:focus-visible { background: var(--color-bee-tint); color: var(--color-ink); }
  .compact { position: fixed; inset: 0 0 auto; z-index: 20; padding-top: env(safe-area-inset-top, 0px); background: var(--color-surface); box-shadow: var(--shadow-sm); transform: translateY(calc(-100% - 8px)); transition: transform var(--transition); }
  .compact.is-visible { transform: none; }
  .compact-row { display: flex; align-items: center; gap: var(--space-4); padding-block: var(--space-4); }
  .compact .topics { flex: 1; }
  .compact .town { min-width: 0; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .logo { display: grid; place-items: center; flex-shrink: 0; width: 2.25rem; height: 2.25rem; border-radius: var(--radius-lg); background: var(--color-bee); color: var(--color-ink); font: var(--weight-heading) var(--text-xl)/1 var(--font-display); text-decoration: none; }
  .logo:hover { background: var(--color-bee-deep); }
  @media (prefers-reduced-motion: reduce) { .compact { transition: none; } }
  @media (max-width: 48rem) {
    .date { visibility: hidden; }
    .bar { padding-block: var(--space-4); }
    .wordmark { font-size: var(--text-2xl); }
    .actions .nb-button-quiet { display: none; }
  }
  @media (max-width: 40rem) {
    .subnav-row { flex-wrap: wrap; gap: var(--space-1); }
    .subnav-row .town { width: 100%; padding-top: var(--space-2); }
    .subnav-row .topics { width: 100%; }
    .compact-row { flex-wrap: wrap; gap: var(--space-2) var(--space-3); padding-block: var(--space-2); }
    .compact .actions { margin-left: auto; }
    .compact .topics { order: 1; flex-basis: 100%; }
  }
  @media (max-width: 32rem) {
    .bar { grid-template-columns: minmax(0, 1fr) auto; }
    .bar .date { display: none; }
    .wordmark { justify-self: start; }
  }
</style>
