---
// The page around a neighborhood edition: document head, the shared design patterns
// (Docs/design-style-guide.html, tokens only) and the summary-width script. Used by
// the neighborhood pages (components/edition/NeighborhoodPage.astro).
import "../../../../../shared/design-tokens.css";
import GoogleAnalytics from "../GoogleAnalytics.astro";
interface Props { title: string; noindex?: boolean }
const { title, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <GoogleAnalytics />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="nb-skip" href="#main">Skip to stories</a>
    <slot />
    <script>
      // Lead stories: keep the summary no wider than the headline's longest line.
      // CSS can't size a block to its wrapped lines, so measure them.
      const matchSummaries = () => {
        for (const block of document.querySelectorAll<HTMLElement>("[data-match-title]")) {
          const title = block.querySelector("h3");
          const summary = block.querySelector<HTMLElement>(".dek");
          if (!title || !summary) continue;
          summary.style.maxWidth = "";
          const range = document.createRange();
          range.selectNodeContents(title);
          const widest = Math.max(...[...range.getClientRects()].map((rect) => rect.width));
          if (Number.isFinite(widest) && widest > 0) summary.style.maxWidth = `${Math.ceil(widest)}px`;
        }
      };
      matchSummaries();
      document.fonts?.ready.then(matchSummaries);
      let frame = 0;
      addEventListener("resize", () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(matchSummaries);
      });
    </script>
  </body>
</html>

<style is:global>
  /* Page base and the shared patterns from Docs/design-style-guide.html. Tokens only. */
  /* This page uses corners at half the shared radius scale.
     :root:root outranks the shared tokens' :root whatever order the CSS loads in. */
  :root:root {
    --radius-xs: 1px;
    --radius-sm: 2px;
    --radius-lg: 4px;
    --radius-xl: 6px;
    --radius-2xl: 8px;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-padding-top: 5.5rem; }
  body {
    margin: 0;
    background: var(--color-surface);
    color: var(--color-ink);
    font: var(--text-body)/var(--leading-body) var(--font-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  h1, h2, h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    text-wrap: balance;
  }
  p { margin: 0; }
  img { display: block; max-width: 100%; }
  :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; } }
  html { scroll-behavior: smooth; }

  .nb-container {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }
  @media (max-width: 40rem) { .nb-container { padding-inline: var(--space-4); } }
  main.nb-container { display: flex; flex-direction: column; gap: calc(var(--space-12) * 2); padding-block: var(--space-8) var(--space-16); }

  .nb-skip { position: absolute; left: -10000px; }
  .nb-skip:focus { left: var(--space-4); top: var(--space-4); z-index: 20; padding: var(--space-2) var(--space-3); background: var(--color-surface); border-radius: var(--radius-lg); }

  /* Uppercase tracked label: section names, categories, dates */
  .nb-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .nb-pill {
    display: inline-block;
    padding: 1px var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-pill-gray);
    color: var(--color-ink-soft);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .nb-button {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: var(--space-2) var(--space-4);
    border: 0;
    border-radius: var(--radius-pill);
    font: 600 var(--text-sm)/1 var(--font-body);
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--transition);
  }
  .nb-button-primary { background: var(--color-bee); }
  .nb-button-primary:hover { background: var(--color-bee-deep); }
  .nb-button-quiet { background: var(--color-pill-gray); }
  .nb-button-quiet:hover { background: var(--color-pill-gray-deep); }
  .nb-link {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-bee-deep);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .nb-card-link { color: inherit; text-decoration: none; }
  .nb-card-link:hover .nb-title { text-decoration: underline; text-decoration-color: var(--color-bee-deep); text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  .nb-dev-bar {
    margin: 0;
    padding: var(--space-2) var(--space-4);
    background: var(--color-cream);
    font-size: var(--text-xs);
    text-align: center;
    color: var(--color-ink-soft);
  }
  .nb-saved {
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-style: italic;
  }
</style>
