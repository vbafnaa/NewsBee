---
import { neighborhoodArt } from "../../../../../shared/neighborhood-illustrations";
import CommunityScene from "./CommunityScene.astro";
interface Props { locationId: string; mediaMode?: string }
const { locationId, mediaMode } = Astro.props;
const profile = mediaMode === "illustrated" ? neighborhoodArt(locationId) : null;
---
{profile && <section class="neighborhood-welcome" aria-labelledby="neighborhood-welcome-heading"
  style={`--community-sky:${profile.presentation?.sky ?? "#edf0e6"};--community-glow:${profile.presentation?.glow ?? "#f6ecd8"}`}>
  <div class="welcome-copy"><h1 id="neighborhood-welcome-heading">Hello, {profile.name}.</h1></div>
  <CommunityScene profile={profile} eager layout="immersive" />
</section>}
<style>
  .neighborhood-welcome { position: relative; isolation: isolate; overflow: clip; width: 100%;
    min-height: clamp(38rem, calc(100svh - 8.75rem), 58rem);
    background: radial-gradient(ellipse at 12% 58%, var(--community-sky), transparent 68%),
      radial-gradient(ellipse at 88% 38%, var(--community-glow), transparent 65%), var(--color-paper); }
  .neighborhood-welcome::after { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to bottom, var(--color-surface) 0%, rgb(255 255 255 / .4) 19%, transparent 43%, transparent 78%, var(--color-surface) 100%); }
  .welcome-copy { position: relative; z-index: 2; text-align: center; pointer-events: none;
    width: min(100% - 2rem, 66rem); margin-inline: auto; padding-top: clamp(2rem, 5svh, 4rem); padding-bottom: 24rem; }
  .welcome-copy > * { pointer-events: auto; }
  h1 { font-size: clamp(2.75rem, 6.6vw, 6rem); line-height: 1.06; letter-spacing: -.035em; }
  @media (max-width: 40rem) {
    .neighborhood-welcome { min-height: max(40rem, calc(100svh - 7.75rem)); }
    .welcome-copy { padding-top: var(--space-8); padding-bottom: 25rem; }
  }
</style>
