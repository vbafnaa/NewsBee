---
import type { DataSource, Story } from "../../lib/edition-view";
import SavedNote from "./SavedNote.astro";

interface Props { stories: Story[]; source: DataSource; }
const { stories, source } = Astro.props;
const [lead, ...rest] = stories;
// Lead on the left half; the other four clustered 2×2 on the right.
const sides = [rest.slice(0, 2), rest.slice(2, 4)];
---
<section id="top-news" class="section" aria-labelledby="top-news-heading">
  <h2 id="top-news-heading" class="visually-hidden">Top news</h2>
  <SavedNote source={source} />
  {lead && (
    <div class="grid">
      <article class="card lead">
        <a class="nb-card-link" href={lead.href} data-story-id={lead.storyId ?? undefined}>
        <div class="body" data-match-title>
          <span class="nb-label">{lead.category} · {lead.date}</span>
          <h3 class="nb-title">{lead.title}</h3>
          <p class="dek">{lead.dek}</p>
        </div>
        </a>
      </article>
      {sides.map((side, index) => (
        <div class={`side ${index === 0 ? "left" : "right"}`}>
          {side.map((story) => (
            <article class="card">
              <a class="nb-card-link" href={story.href} data-story-id={story.storyId ?? undefined}>
              <div class="body">
                <span class="nb-label">{story.category} · {story.date}</span>
                <h3 class="nb-title">{story.title}</h3>
              </div>
              </a>
            </article>
          ))}
        </div>
      ))}
    </div>
  )}
</section>

<style>
  .section { display: flex; flex-direction: column; gap: var(--space-5); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: "lead left right";
    gap: var(--space-6);
  }
  .lead { grid-area: lead; }
  .left { grid-area: left; }
  .right { grid-area: right; }
  .side { display: flex; flex-direction: column; gap: var(--space-6); min-width: 0; }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }
  .body { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .card h3 { font-size: var(--text-lg); line-height: var(--leading-h3); letter-spacing: var(--tracking-h3); }
  .dek {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lead { gap: var(--space-4); }
  .lead h3 { font-size: var(--text-h2); line-height: var(--leading-h2); letter-spacing: var(--tracking-h2); }
  .lead .dek { font-size: var(--text-base); }
  @media (max-width: 64rem) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-areas: "lead lead" "left right"; }
  }
  @media (max-width: 40rem) {
    .grid { grid-template-columns: 1fr; grid-template-areas: "lead" "left" "right"; }
  }
</style>
