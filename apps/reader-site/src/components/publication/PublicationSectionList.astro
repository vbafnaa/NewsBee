---
import StoryMedia from "../edition/StoryMedia.astro";
import PublicationShell from "./PublicationShell.astro";
import { publicationPageLinks, type PublicationPage } from "../../lib/publication-view";
import type { NewsroomTab } from "../../lib/edition-view";
interface Props { page: PublicationPage; section: NewsroomTab }
const { page, section } = Astro.props;
const links = publicationPageLinks(page);
---
<PublicationShell page={page} title={`${section.label} | ${page.publication.displayName}`} subPage>
  <section class="listing">
    <a class="nb-link" href={`${links.page}#${section.id}`}>Back to {page.publication.displayName}</a>
    <h1>{section.label}</h1>
    <ol>{section.stories.map((story) => <li>
      <StoryMedia photo={story.photo} illustration={story.illustration} />
      <a class="nb-card-link" href={story.href}>
        <span class="nb-label">{story.date}{story.locationLabel ? ` · ${story.locationLabel}` : ""}</span>
        <span class="nb-title">{story.title}</span>
        <span>{story.sourceName}</span>
      </a>
    </li>)}</ol>
  </section>
</PublicationShell>
<style>
  .listing { display: grid; gap: var(--space-6); max-width: 48rem; }
  h1 { font-size: var(--text-h1); } ol { margin: 0; padding: 0; list-style: none; }
  li { display: grid; gap: var(--space-5); padding-block: var(--space-6); border-bottom: 1px solid var(--color-line); }
  li:has(figure) { grid-template-columns: minmax(0, 14rem) minmax(0, 1fr); }
  li a { display: flex; flex-direction: column; gap: var(--space-2); }
</style>
