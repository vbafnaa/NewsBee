---
import EditionLayout from "../components/edition/EditionLayout.astro";
import StoryIllustration from "../components/edition/StoryIllustration.astro";
import { ILLUSTRATIONS, ILLUSTRATION_DISCLOSURE, ILLUSTRATION_POLICY } from "../../../../shared/editorial-illustrations";
import { NEIGHBORHOOD_ART, neighborhoodArtAsset } from "../../../../shared/neighborhood-illustrations";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<EditionLayout title="Our illustrations | Newsbee">
  <main id="main" class="nb-container">
    <a class="back" href={base || "/"}>Newsbee</a>
    <header><p class="eyebrow">A little color for your community</p><h1>Local stories, gently illustrated.</h1>
      <p>Original watercolor graphics for the things happening around us.</p>
      <p class="disclosure">{ILLUSTRATION_DISCLOSURE} We match artwork to the subject and use each image at most once in an edition.</p>
    </header>
    <section class="neighborhoods" aria-label="Individual neighborhood portraits">
      {NEIGHBORHOOD_ART.map(profile => <article><h2>{profile.name}, at heart.</h2><p>{profile.palette}</p>
        <figure><img src={neighborhoodArtAsset(profile, base)} alt={profile.alt} width="2172" height="724" loading="eager" /></figure>
      </article>)}
    </section>
    <section class="local-scenes" aria-label="Neighborhood story illustrations">
      <article><StoryIllustration illustration={{id: "books", asset_id: "wedgwood-books", policy: ILLUSTRATION_POLICY, alt: "AI watercolor reading nook with leafy Wedgwood-style houses beyond a window."}} /><h2>A Wedgwood reading corner</h2></article>
      <article><StoryIllustration illustration={{id: "sports", asset_id: "moses-lake-football", policy: ILLUSTRATION_POLICY, alt: "AI watercolor football still life with blue lake water and golden Columbia Basin grassland."}} /><h2>Football, with a Moses Lake feel</h2></article>
    </section>
    <section class="gallery" aria-label="Newsbee watercolor collection">
      {ILLUSTRATIONS.map(art => <article><StoryIllustration illustration={{ id: art.id, alt: art.alt, policy: ILLUSTRATION_POLICY }} /><h2>{art.title}</h2></article>)}
    </section>
  </main>
</EditionLayout>
<style>
  main { padding-block: var(--space-8) var(--space-16); }
  .back { color: var(--color-ink); font: 600 var(--text-2xl) var(--font-display); text-decoration: none; }
  header { max-width: 46rem; margin: var(--space-16) auto var(--space-12); text-align: center; }
  .eyebrow { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: .12em; }
  h1 { margin-block: var(--space-4); font-size: var(--text-h1); line-height: 1.15; }
  header p { color: var(--color-muted); line-height: 1.7; }
  .disclosure { max-width: 62ch; margin: var(--space-5) auto 0; font-size: var(--text-sm); }
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-12) var(--space-8); }
  .neighborhoods, .local-scenes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8); }
  .neighborhoods figure { margin: var(--space-4) 0 0; }
  .neighborhoods img { width: 100%; height: auto; mix-blend-mode: multiply; }
  .neighborhoods p, .neighborhoods figcaption { color: var(--color-muted); font-size: var(--text-xs); }
  article { min-width: 0; }
  h2 { font-size: var(--text-lg); margin-top: var(--space-3); }
  @media (max-width: 56rem) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 36rem) { .gallery, .neighborhoods, .local-scenes { grid-template-columns: 1fr; } header { margin-block: var(--space-10); } }
</style>
