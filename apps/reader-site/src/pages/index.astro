---
// Published neighborhoods and their sections render on the server; other communities use the picker.
import Landing from "../components/Landing.astro";
import EditionLayout from "../components/edition/EditionLayout.astro";
import NeighborhoodHome from "../components/edition/NeighborhoodHome.astro";
import SectionList from "../components/edition/SectionList.astro";
import EventsList from "../components/edition/EventsList.astro";
import ArticlePage from "../components/edition/ArticlePage.astro";
import AllStories from "../components/edition/AllStories.astro";
import { loadEditionPage } from "../lib/edition-view";

const params = Astro.url.searchParams;
const locationId = params.get("location");
const editionId = params.get("edition");
const storyKey = params.get("story");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
let error = "";
const page = locationId
  ? await loadEditionPage(locationId, editionId).catch((cause) => {
      console.error("Reader edition unavailable", cause);
      Astro.response.status = 503;
      error = "Edition unavailable right now. Please try again.";
      return null;
    })
  : null;
if (!error && locationId && editionId && !page) {
  Astro.response.status = 404;
  error = "This published edition could not be found for this community.";
}
const view = params.get("section");
const section = page && view ? page.allSections.find((candidate) => candidate.id === view) : undefined;
const article = page?.articles.find((candidate) => candidate.key === storyKey);
if (!error && storyKey !== null && !article) {
  Astro.response.status = 404;
  error = "This story could not be found in this community's published edition.";
}
---
{error ? <EditionLayout title="Edition unavailable | Newsbee">
    <main id="main" class="nb-container">
      <p role="alert">{error}</p>
      <a class="nb-link" href={Astro.url.href}>Try again</a>
      <a class="nb-link" href={`${base}?location=${encodeURIComponent(locationId ?? "")}`}>Latest edition</a>
      <a class="nb-link" href={base || "/"}>Find another neighborhood</a>
    </main>
  </EditionLayout>
  : page
    ? article ? <ArticlePage page={page} article={article} />
      : view === "all" ? <AllStories page={page} />
      : view === "events" ? <EventsList page={page} requested={params.get("day")} />
      : section ? <SectionList page={page} section={section} />
      : <NeighborhoodHome page={page} />
    : <Landing />}
