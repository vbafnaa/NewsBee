---
import SignupForm from "../components/SignupForm.astro";
const apiUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Newsbee</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,400&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#landing-title">Skip to find your neighborhood</a>
    <main data-api-url={apiUrl} class="is-landing">
      <header class="masthead">
        <div class="ears">
          <span>Your community, this week</span>
          <button id="edition-toggle" type="button" hidden>Find another neighborhood</button>
        </div>
        <h1 class="title">Newsbee</h1>
        <p class="subtitle" id="edition-name">Local news. Shared stories.</p>
        <div class="dateline" hidden>
          <span id="edition-week">&nbsp;</span>
          <span id="edition-published">&nbsp;</span>
        </div>
      </header>
      <section id="landing" aria-labelledby="landing-title">
        <div class="landing-ornament" aria-hidden="true"><span></span><svg viewBox="0 0 40 36" fill="none">
          <path d="M19 15C3-1 2 20 17 21M22 15C37-1 39 20 24 21" fill="#f0dfba" stroke="currentColor" />
          <ellipse cx="20.5" cy="23" rx="6" ry="9" fill="#c7a04f" stroke="currentColor" />
          <path d="M15 21h11M16 26h9M18 14l-3-4M23 14l3-4" stroke="currentColor" stroke-width="2" />
        </svg><span></span></div>
        <h2 id="landing-title" tabindex="-1">Good stories start <em>nearby.</em></h2>
        <p class="landing-intro">Discover what's happening around you, from civic updates to weekend plans.</p>
        <div class="picker">
              <label class="visually-hidden" for="location">Find your neighborhood</label>
              <div class="location-field">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.5" aria-hidden="true">
                  <circle cx="10.5" cy="10.5" r="6.5" />
                  <path d="m15.5 15.5 5 5" />
                </svg>
                <input id="location" type="text" role="combobox" aria-autocomplete="list"
                  aria-expanded="false" aria-controls="location-options" aria-describedby="location-help"
                  placeholder="Find your neighborhood" autocomplete="off" maxlength="80" disabled />
                <button id="location-toggle" type="button" aria-label="Browse editions and search"
                  aria-expanded="false" aria-controls="edition-picker" disabled>
                  <span class="chevron" aria-hidden="true"></span>
                </button>
              </div>
              <div id="edition-picker" hidden>
                <div id="published-group">
                  <p class="picker-heading">Published editions</p>
                  <div id="onboarded-editions" aria-label="Published editions"></div>
                  <p id="published-empty" hidden>No editions yet. Search for your neighborhood to help bring Newsbee here.</p>
                </div>
                <ul id="location-options" role="listbox" aria-label="Locations" hidden></ul>
                <p id="location-help" aria-live="polite">Pick an edition, or type a neighborhood, town, or city.</p>
                <button id="discover-communities" type="button" disabled hidden>Search all communities</button>
                <p class="geographic-attribution" hidden>Search by Photon / <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap</a></p>
              </div>
        </div>
        <svg class="neighborhood-art" viewBox="0 0 800 165" fill="none" aria-hidden="true">
          <circle cx="652" cy="45" r="27" fill="#e8cc8e" stroke="none" />
          <path d="M20 149h760M40 155h120m465 0h110" stroke="#bdb19a" />
          <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M100 147V85l42-35 42 35v62" fill="#e8dbc4" />
            <path d="m91 87 51-43 51 43M126 147v-37h28v37M112 87h17v15h-17zm43 0h17v15h-17z" />
            <path d="M208 147V71h103v76" fill="#eee5d2" />
            <path d="M201 71h117v-9H201zM219 106h81v17h-81z" fill="#cda78c" />
            <path d="M219 147v-24m27 0v24m27-24v24m27-24v24M224 82h70v15h-70z" />
            <path d="M340 147V58l36-26 36 26v89" fill="#e6d6b8" />
            <path d="m333 60 43-34 43 34M365 147v-32h22v32M353 72h15v24h-15zm31 0h15v24h-15z" />
            <path d="M439 147V92h100v55" fill="#eee5d2" />
            <path d="M432 92h114l-8-21h-98z" fill="#aeb9a4" />
            <path d="M451 104h24v27h-24zm38 43v-43h35v43M445 80h88" />
            <path d="M586 147V90m0 20-16-17m16 10 17-21" />
            <path d="M568 96c-28-1-28-29-13-36-10-20 12-35 28-26 17-21 44-4 39 16 25 9 17 42-8 42-11 13-31 13-46 4Z" fill="#d3dac6" />
            <path d="M586 147V65m0 24-15-14m15 3 14-14" />
            <path d="M678 147v-24m-19 0h38v-9h-38zm4 0v13m30-13v13M58 147v-34m0 12-8-7m8 17 9-8" />
            <path d="M61 110c-13-19-27 2-10 7m12-4c17-20 25 4 5 7" stroke="#7c8c72" />
            <path d="m696 59 7-4 7 4m-56-39 7-4 7 4" stroke="#9b8d72" />
          </g>
        </svg>
      </section>
      <p id="edition-status" role="status">Loading locations...</p>
      <button id="retry" type="button" hidden>Try again</button>
      <section id="expansion" aria-labelledby="expansion-title" hidden>
        <p class="eyebrow">Your community deserves its own front page</p>
        <h2 id="expansion-title" tabindex="-1"></h2>
        <p>Every community has stories worth telling. Help bring local events, civic updates,
          and a little more connection to yours.</p>
      </section>
      <article id="edition" aria-label="Edition" tabindex="-1" hidden>
        <p id="edition-freshness" role="status"></p>
        <aside id="corrections" aria-label="Corrections" hidden></aside>
        <h2 id="edition-headline" tabindex="-1"></h2>
        <p id="edition-intro" class="deck"></p>
        <div id="front-page">
          <div id="edition-lead"></div>
          <div id="edition-items" class="columns"></div>
        </div>
        <section id="upcoming-events" aria-labelledby="upcoming-events-title" hidden>
          <h2 id="upcoming-events-title">Upcoming events</h2>
          <div id="upcoming-items" class="columns"></div>
        </section>
        <details id="edition-sources" class="coverage">
          <summary>Sources &amp; edition notes <span id="source-count"></span></summary>
          <ol id="source-items"></ol>
          <div id="coverage-notes">
            <h3>Coverage notes</h3>
            <ul id="edition-coverage"></ul>
          </div>
        </details>
        <footer>
          <p class="subscription-invitation">Interested in weekly updates? <a id="subscription-link">Sign up here</a>.</p>
          <p id="edition-window"></p>
          <p>Compiled automatically from library listings, public meeting records and, where local news is thin, official county, nearby-town and trend sources. Not independent reporting. Check the original source before you go.</p>
        </footer>
      </article>
      <section id="subscription" aria-labelledby="subscription-title" hidden>
        <h2 id="subscription-title" tabindex="-1"></h2>
        <SignupForm launchNotification={true} />
      </section>
    </main>
    <script>
      import { newsletterSections } from "../../../../shared/newsletter-layout";
      type Listing = { location_id: string; location_name: string; edition_id: string | null };
      type Town = { id: string; name: string };
      type Item = {
        story_id: string | null;
        headline: string;
        blurb: string;
        when_where: string;
        source_url: string | null;
        rank: number | null;
        kind: "event" | "meeting_preview" | "meeting_outcome" | "state_news" | "earthquake" | "trending_topic" | "social_trend";
        source_name: string;
        section?: string | null;
        local?: boolean;
      };
      type Edition = {
        headline: string;
        intro: string;
        window_start: string;
        window_end: string;
        published_at: number;
        items: Item[];
        coverage: string[];
        corrections: { reason: string; created_at: number }[];
      };

      const main = document.querySelector("main")!;
      const api = main.dataset.apiUrl;
      const input = document.querySelector<HTMLInputElement>("#location")!;
      const discoverButton = document.querySelector<HTMLButtonElement>("#discover-communities")!;
      const options = document.querySelector<HTMLUListElement>("#location-options")!;
      const help = document.querySelector<HTMLParagraphElement>("#location-help")!;
      const picker = document.querySelector<HTMLElement>(".picker")!;
      const pickerPanel = document.querySelector<HTMLElement>("#edition-picker")!;
      const locationToggle = document.querySelector<HTMLButtonElement>("#location-toggle")!;
      const publishedGroup = document.querySelector<HTMLElement>("#published-group")!;
      const geographicAttribution = document.querySelector<HTMLElement>(".geographic-attribution")!;
      const landing = document.querySelector<HTMLElement>("#landing")!;
      const dateline = document.querySelector<HTMLElement>(".dateline")!;
      const skipLink = document.querySelector<HTMLAnchorElement>(".skip-link")!;
      const pickerToggle = document.querySelector<HTMLButtonElement>("#edition-toggle")!;
      const onboarded = document.querySelector<HTMLDivElement>("#onboarded-editions")!;
      const status = document.querySelector<HTMLParagraphElement>("#edition-status")!;
      const article = document.querySelector<HTMLElement>("#edition")!;
      const retry = document.querySelector<HTMLButtonElement>("#retry")!;
      const expansion = document.querySelector<HTMLElement>("#expansion")!;
      const subscription = document.querySelector<HTMLElement>("#subscription")!;
      const signupForm = document.querySelector<HTMLFormElement>("#subscription-form")!;
      const signupButton = signupForm.querySelector<HTMLButtonElement>("button")!;
      const signupStatus = document.querySelector<HTMLParagraphElement>("#signup-status")!;
      const listings = new Map<string, Listing>();
      let selected: Town | undefined;
      let candidates: Town[] = [];
      let active = -1;
      let searchVersion = 0;
      let searchTimer: ReturnType<typeof setTimeout>;
      let discovering = false;
      let navigationVersion = 0;

      const text = (tag: string, value: string, className?: string) => {
        const node = document.createElement(tag);
        node.textContent = value;
        if (className) node.className = className;
        return node;
      };
      const failure = (error: unknown) => (error instanceof Error ? error.message : String(error));
      const place = (name: string) => name.replace(/,\s*[A-Z]{2}$/, "");
      const day = (iso: string, options: Intl.DateTimeFormatOptions) =>
        new Date(`${iso}T12:00:00`).toLocaleDateString("en-US", options);

      async function getJson(path: string, init?: RequestInit) {
        const response = await fetch(`${api}${path}`, {
          ...init, signal: AbortSignal.timeout(path.includes("discover=true") ? 30000 : 5000),
        });
        if (!response.ok) throw new Error(`API returned HTTP ${response.status}`);
        return response.json();
      }

      const same = (a: string, b: string) =>
        a.toLowerCase().replace(/[^a-z0-9]/g, "") === b.toLowerCase().replace(/[^a-z0-9]/g, "");

      function genericHeadline(edition: Edition, town: Town) {
        const sameMonth = edition.window_start.slice(0, 7) === edition.window_end.slice(0, 7);
        const week = `${day(edition.window_start, { month: "short", day: "numeric" })}\u2013${day(
          edition.window_end, sameMonth ? { day: "numeric" } : { month: "short", day: "numeric" },
        )}`;
        return [town.name, place(town.name)].some((name) =>
          [name, `${name} this week`, `This week in ${name}`, `The ${name} Edition`]
            .some((candidate) => same(edition.headline, candidate) || same(edition.headline, `${candidate}: ${week}`)),
        );
      }

      function story(item: Item, lead: boolean, reference: number, repeatsFront = false) {
        const section = document.createElement("section");
        section.className = lead ? `story lead${repeatsFront ? " repeats-front" : ""}` : "story";
        if (item.story_id) section.id = `story-${item.story_id}`;
        if (item.section && item.section !== "Upcoming events") section.append(text("p", item.section, "kicker"));
        if (lead) section.append(text("p", "In focus", "lead-label"));
        const headline = text("h3", item.headline);
        const blurb = text("p", item.blurb, "blurb");
        const citation = document.createElement("sup");
        const link = text("a", String(reference)) as HTMLAnchorElement;
        link.id = `citation-${reference}`;
        link.href = `#source-${reference}`;
        link.setAttribute("aria-label", `Source ${reference} for ${item.headline}`);
        link.addEventListener("click", (event) => {
          event.preventDefault();
          document.querySelector<HTMLDetailsElement>("#edition-sources")!.open = true;
          document.querySelector<HTMLElement>(`#source-${reference}`)!.focus();
        });
        citation.append(link);
        (repeatsFront ? blurb : headline).append(citation);
        section.append(headline, blurb);
        const locationOnly = selected && [selected.name, place(selected.name)]
          .some((name) => same(item.when_where, name));
        if (item.when_where.trim() && !locationOnly) section.append(text("p", item.when_where, "when-where"));
        return section;
      }

      function source(item: Item, index: number) {
        const entry = document.createElement("li");
        entry.id = `source-${index + 1}`;
        entry.tabIndex = -1;
        if (item.source_url?.startsWith("https://")) {
          const link = text("a", item.source_name) as HTMLAnchorElement;
          link.href = item.source_url;
          link.rel = "noreferrer";
          entry.append(link);
        } else {
          entry.append(text("span", item.source_name));
        }
        const back = text("a", "\u21a9", "source-back") as HTMLAnchorElement;
        back.href = `#citation-${index + 1}`;
        back.setAttribute("aria-label", `Back to story ${index + 1}`);
        entry.append(" ", back);
        return entry;
      }

      function masthead(listing: Listing | undefined, edition?: Edition) {
        document.querySelector("#edition-name")!.textContent = listing
          ? `${place(listing.location_name)} \u00b7 Community edition`
          : "Local news. Shared stories.";
        dateline.hidden = !edition;
        document.querySelector("#edition-week")!.textContent = edition
          ? `Week of ${day(edition.window_start, { month: "short", day: "numeric" })} \u2013 ${day(
              edition.window_end,
              { month: "short", day: "numeric", year: "numeric" },
            )}`
          : "\u00a0";
        document.querySelector("#edition-published")!.textContent = edition
          ? `Published ${new Date(edition.published_at * 1000).toLocaleDateString("en-US", {
              weekday: "long",
              month: "long",
              day: "numeric",
            })}`
          : "\u00a0";
      }

      function closeOptions() {
        clearTimeout(searchTimer);
        searchVersion++;
        options.hidden = true;
        input.setAttribute("aria-expanded", "false");
        input.removeAttribute("aria-activedescendant");
        active = -1;
      }

      function closePicker() {
        closeOptions();
        pickerPanel.hidden = true;
        locationToggle.setAttribute("aria-expanded", "false");
      }

      function openPicker() {
        pickerPanel.hidden = false;
        locationToggle.setAttribute("aria-expanded", "true");
        const hasQuery = input.value.trim().length > 0;
        publishedGroup.hidden = hasQuery;
        discoverButton.hidden = !hasQuery;
        geographicAttribution.hidden = !hasQuery;
        if (!hasQuery) help.textContent = "Pick an edition, or type a neighborhood, town, or city.";
      }

      locationToggle.addEventListener("click", () => {
        if (pickerPanel.hidden) {
          input.focus();
          openPicker();
        } else closePicker();
      });
      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !picker.contains(event.target)) closePicker();
      });
      document.addEventListener("pointerdown", (event) => {
        if (event.target instanceof Node && !picker.contains(event.target)) closePicker();
      });
      picker.addEventListener("focusout", (event) => {
        // Touch browsers can blur the input without focusing the tapped option.
        if (event.relatedTarget instanceof Node && !picker.contains(event.relatedTarget)) closePicker();
      });
      picker.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          input.focus();
          closePicker();
        }
      });

      function showLanding(updateUrl = true, focus = true) {
        navigationVersion++;
        closePicker();
        main.classList.add("is-landing");
        selected = undefined;
        landing.hidden = false;
        pickerToggle.hidden = true;
        article.hidden = true;
        expansion.hidden = true;
        subscription.hidden = true;
        retry.hidden = true;
        status.textContent = "";
        input.value = "";
        discoverButton.disabled = true;
        help.textContent = "Pick an edition, or type a neighborhood, town, or city.";
        masthead(undefined);
        document.title = "Newsbee";
        skipLink.href = "#landing-title";
        skipLink.textContent = "Skip to find your neighborhood";
        if (updateUrl) {
          const url = new URL(window.location.href);
          url.searchParams.delete("location");
          url.hash = "";
          history.pushState(null, "", url);
        }
        if (focus) input.focus();
      }

      pickerToggle.addEventListener("click", () => showLanding());

      function highlight(index: number) {
        active = index;
        Array.from(options.children).forEach((option, i) =>
          option.setAttribute("aria-selected", String(i === active)),
        );
        const option = options.children[active];
        if (option) {
          input.setAttribute("aria-activedescendant", option.id);
          option.scrollIntoView({ block: "nearest" });
        }
      }

      async function searchTowns(discover = false) {
        closeOptions();
        openPicker();
        const query = input.value.trim();
        if (!query) return;
        if (query.split(",")[0].trim().length < 2) {
          help.textContent = "Type at least two letters. Add a state, like Seattle, WA.";
          return;
        }
        const version = searchVersion;
        if (discover) {
          discovering = true;
          input.focus({ preventScroll: true });
          discoverButton.disabled = true;
          discoverButton.textContent = "Searching...";
        }
        help.textContent = discover ? "Searching all US communities..." : "Searching saved communities...";
        try {
          const data = await getJson(`/api/locations/search?q=${encodeURIComponent(query)}${discover ? "&discover=true" : ""}`);
          if (version !== searchVersion) return;
          candidates = data.results as Town[];
          options.replaceChildren(...candidates.map((town, index) => {
            const option = text("li", town.name);
            option.id = `location-option-${index}`;
            option.setAttribute("role", "option");
            option.setAttribute("aria-selected", "false");
            option.addEventListener("mousedown", (event) => event.preventDefault());
            option.addEventListener("click", () => choose(town));
            return option;
          }));
          options.hidden = candidates.length === 0;
          input.setAttribute("aria-expanded", String(candidates.length > 0));
          help.textContent = candidates.length
            ? `${candidates.length} communities found. Use arrow keys and Enter, or select a community.`
            : discover
              ? "No matching communities. Try a different spelling or include the city and state."
              : "No saved matches. Press Search all communities to find more neighborhoods and towns.";
        } catch (error) {
          if (version === searchVersion) help.textContent = `Location search unavailable: ${failure(error)}`;
        } finally {
          if (discover) {
            discovering = false;
            discoverButton.textContent = "Search all communities";
            discoverButton.disabled = input.value.split(",")[0].trim().length < 2;
          }
        }
      }

      async function choose(town: Town, updateUrl = true) {
        navigationVersion++;
        closePicker();
        main.classList.remove("is-landing");
        selected = town;
        input.value = "";
        landing.hidden = true;
        pickerToggle.hidden = false;
        document.title = `${town.name} | Newsbee`;
        onboarded.querySelectorAll<HTMLButtonElement>("button").forEach((button) =>
          button.setAttribute("aria-current", String(button.dataset.locationId === town.id)),
        );
        if (updateUrl) {
          const url = new URL(window.location.href);
          url.searchParams.set("location", town.id);
          url.hash = "";
          history.pushState(null, "", url);
        }
        await show(town);
      }

      input.addEventListener("input", () => {
        closeOptions();
        openPicker();
        discoverButton.disabled = discovering || input.value.split(",")[0].trim().length < 2;
        searchTimer = setTimeout(searchTowns, 250);
      });
      discoverButton.addEventListener("click", () => {
        if (!discovering) void searchTowns(true);
      });
      input.addEventListener("focus", () => {
        input.select();
        openPicker();
        if (!discovering) void searchTowns();
      });
      input.addEventListener("click", () => {
        if (pickerPanel.hidden) {
          openPicker();
          if (!discovering) void searchTowns();
        }
      });
      input.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closePicker();
        } else if (event.key === "ArrowDown" && !input.value.trim()) {
          event.preventDefault();
          openPicker();
          onboarded.querySelector<HTMLButtonElement>("button")?.focus();
        } else if (!options.hidden && ["ArrowDown", "ArrowUp"].includes(event.key)) {
          event.preventDefault();
          const next = active < 0
            ? (event.key === "ArrowDown" ? 0 : candidates.length - 1)
            : (active + (event.key === "ArrowDown" ? 1 : -1) + candidates.length) % candidates.length;
          highlight(next);
        } else if (event.key === "Enter") {
          event.preventDefault();
          if (!options.hidden && active >= 0) choose(candidates[active]);
          else if (!discovering && !discoverButton.disabled) void searchTowns(true);
          else help.textContent = "Select a community from the suggestions.";
        }
      });

      async function show(town: Town) {
        article.hidden = true;
        retry.hidden = true;
        expansion.hidden = true;
        subscription.hidden = true;
        signupStatus.textContent = "";
        signupForm.reset();
        signupButton.disabled = false;
        signupForm.dataset.locationId = town.id;
        signupForm.dataset.locationName = town.name;
        const subscriptionLink = document.querySelector<HTMLAnchorElement>("#subscription-link")!;
        subscriptionLink.href = `${api}/subscribe?location=${encodeURIComponent(town.id)}`;
        document.querySelector("#subscription-title")!.textContent = `Weekly editions for ${town.name}`;
        document.querySelector("#signup-location")!.textContent = town.name;
        const locationId = town.id;
        const listing = listings.get(town.id);
        masthead(listing);
        if (!listing?.edition_id) {
          document.querySelector("#expansion-title")!.textContent =
            `We're not in ${place(town.name)} yet. Let's change that.`;
          document.querySelector("#edition-name")!.textContent = town.name;
          status.textContent = "";
          expansion.hidden = false;
          subscription.hidden = false;
          skipLink.href = "#expansion-title";
          skipLink.textContent = "Skip to your community";
          document.querySelector<HTMLElement>("#expansion-title")!.focus();
          return;
        }
        skipLink.href = "#edition-headline";
        skipLink.textContent = "Skip to this week's stories";
        status.textContent = "Loading edition...";
        pickerToggle.focus({ preventScroll: true });
        try {
          const edition: Edition = await getJson(`/api/editions/${encodeURIComponent(locationId)}`);
          if (selected?.id !== locationId) return;
          masthead(listing, edition);
          const headline = document.querySelector<HTMLElement>("#edition-headline")!;
          const intro = document.querySelector<HTMLElement>("#edition-intro")!;
          const generic = genericHeadline(edition, town);
          headline.textContent = edition.headline;
          headline.hidden = generic;
          intro.textContent = edition.intro;
          intro.hidden = !edition.intro.trim() ||
            same(edition.intro, `This week's highlights from around ${place(town.name)}.`);
          skipLink.href = generic ? "#edition" : "#edition-headline";
          document.querySelector("#edition-window")!.textContent =
            `Upcoming listings: ${edition.window_start} to ${edition.window_end}. Meeting outcomes may cover the preceding week.`;
          const now = new Date();
          const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
          document.querySelector("#edition-freshness")!.textContent =
            edition.window_end < today ? "Past edition: these listings may no longer be current." : "";
          document.querySelector("#edition-coverage")!.replaceChildren(
            ...(edition.coverage ?? []).map((message) => text("li", message)),
          );
          document.querySelector<HTMLElement>("#coverage-notes")!.hidden = !edition.coverage?.length;
          document.querySelector<HTMLDetailsElement>("#edition-sources")!.open = false;
          const corrections = document.querySelector<HTMLElement>("#corrections")!;
          const notices = edition.corrections ?? [];
          corrections.hidden = notices.length === 0;
          corrections.replaceChildren(
            ...notices.map((notice) =>
              text("p", `Correction (${new Date(notice.created_at * 1000).toLocaleDateString("en-US")}): ${notice.reason}`),
            ),
          );
          const { news, upcoming } = newsletterSections(edition.items);
          const ordered = [...news, ...upcoming];
          const references = new Map(ordered.map((item, index) => [item, index + 1]));
          document.querySelector("#source-items")!.replaceChildren(...ordered.map(source));
          document.querySelector("#source-count")!.textContent = `(${edition.items.length})`;
          const lead = news[0];
          document.querySelector("#edition-lead")!.replaceChildren(
            ...(lead ? [story(lead, true, references.get(lead)!, !generic && same(lead.headline, edition.headline))] : []),
          );
          document
            .querySelector("#edition-items")!
            .replaceChildren(...news.filter((item) => item !== lead).map((item) => story(item, false, references.get(item)!)));
          document.querySelector<HTMLElement>("#front-page")!.hidden = news.length === 0;
          document.querySelector<HTMLElement>("#front-page")!.classList.toggle("lead-only", news.length === 1);
          document.querySelector<HTMLElement>("#upcoming-events")!.hidden = upcoming.length === 0;
          document.querySelector("#upcoming-items")!.replaceChildren(...upcoming.map((item) => story(item, false, references.get(item)!)));
          article.hidden = false;
          status.textContent = "";
          if (!generic) headline.focus({ preventScroll: true });
        } catch (error) {
          if (selected?.id !== locationId) return;
          status.textContent = `Edition unavailable: ${failure(error)}`;
          retry.hidden = false;
        }
      }
      retry.addEventListener("click", () => {
        if (selected && listings.has(selected.id)) show(selected);
        else window.location.reload();
      });

      async function openRequestedLocation() {
        const requested = new URLSearchParams(location.search).get("location");
        if (!requested) {
          showLanding(false, false);
          return;
        }
        const listing = listings.get(requested);
        if (listing) {
          await choose({ id: listing.location_id, name: listing.location_name }, false);
          return;
        }
        showLanding(false, false);
        const version = navigationVersion;
        status.textContent = "Finding your community...";
        try {
          const town: Town = await getJson(`/api/locations/${encodeURIComponent(requested)}`);
          if (version === navigationVersion) await choose(town, false);
        } catch (error) {
          if (version === navigationVersion) {
            status.textContent = `Location unavailable: ${failure(error)}. Use the community search to try again.`;
          }
        }
      }
      window.addEventListener("popstate", () => void openRequestedLocation());

      try {
        const data = await getJson("/api/editions");
        if (!Array.isArray(data.locations)) throw new Error("Unsupported editions contract");
        for (const listing of data.locations as Listing[]) {
          listings.set(listing.location_id, listing);
          if (!listing.edition_id) continue;
          const button = text("button", listing.location_name) as HTMLButtonElement;
          button.type = "button";
          button.dataset.locationId = listing.location_id;
          button.addEventListener("click", () => choose({
            id: listing.location_id, name: listing.location_name,
          }));
          onboarded.append(button);
        }
        document.querySelector<HTMLElement>("#published-empty")!.hidden = onboarded.childElementCount > 0;
        input.disabled = false;
        locationToggle.disabled = false;
        await openRequestedLocation();
      } catch (error) {
        status.textContent = `Editions unavailable: ${failure(error)}`;
        retry.hidden = false;
      }
