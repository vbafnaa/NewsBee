---
import "../../../../shared/design-tokens.css";
import SignupForm from "../components/SignupForm.astro";
import { directoryTown, type Location } from "../lib/reader-data";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const locationId = Astro.url.searchParams.get("location");
let town: Location | null = null;
let error = "";
if (!locationId) {
  Astro.response.status = 400;
  error = "Choose a community before signing up for weekly updates.";
} else {
  try {
    town = await directoryTown(locationId);
    if (!town) {
      Astro.response.status = 404;
      error = "This community could not be found. Choose a community to try again.";
    }
  } catch (cause) {
    console.error("Reader signup location lookup unavailable", cause);
    Astro.response.status = 503;
    error = "Signup is temporarily unavailable. Please try again later.";
  }
}
const backUrl = town ? `${base}?location=${encodeURIComponent(town.id)}` : base;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{town ? `Weekly updates for ${town.name} | Newsbee` : "Weekly updates | Newsbee"}</title>
  </head>
  <body>
    <main>
      <header>
        <a class="brand" href={base}>Newsbee</a>
        <p>Your community, this week</p>
      </header>
      {town ? (
        <section aria-labelledby="signup-title">
          <h1 id="signup-title">Weekly updates for {town.name}</h1>
          <p>Stay connected with local stories, civic updates, and nearby events.</p>
          <SignupForm locationId={town.id} locationName={town.name} />
        </section>
      ) : <p role="alert">{error}</p>}
      <p><a href={backUrl}>{town ? `Back to ${town.name}` : "Find your neighborhood"}</a></p>
    </main>
  </body>
</html>
<style is:global>
  :root { --paper: var(--color-paper); --ink: var(--color-ink); --muted: var(--color-muted); --rule: var(--color-line); --accent: var(--color-bee); }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: var(--text-body)/var(--leading-body) var(--font-body); -webkit-font-smoothing: antialiased; }
  main { max-width: 40rem; margin: 2rem auto; padding: 2rem; background: var(--paper); text-align: center; }
  header { border-bottom: 1px solid var(--rule); }
  header p { color: var(--muted); }
  .brand { font: var(--weight-heading) 3rem/1 var(--font-display); letter-spacing: -0.02em; color: var(--ink); text-decoration: none; }
  h1 { font: var(--weight-heading) var(--text-h3)/var(--leading-h3) var(--font-display); letter-spacing: var(--tracking-h3); text-wrap: balance; }
  a { color: var(--ink); text-decoration-color: var(--color-bee-deep); text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  @media (max-width: 640px) { main { margin: 0; padding: 1.5rem 1rem; min-height: 100vh; } }
</style>
