---
import SignupForm from "../components/SignupForm.astro";
import { directoryTown, type Location } from "../lib/reader-data";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const locationId = Astro.url.searchParams.get("location");
let town: Location | null = null;
let error = "";
if (!locationId) {
  Astro.response.status = 400;
  error = "Choose a community before signing up for weekly updates.";
} else {
  try {
    town = await directoryTown(locationId);
    if (!town) {
      Astro.response.status = 404;
      error = "This community could not be found. Choose a community to try again.";
    }
  } catch (cause) {
    console.error("Reader signup location lookup unavailable", cause);
    Astro.response.status = 503;
    error = "Signup is temporarily unavailable. Please try again later.";
  }
}
const backUrl = town ? `${base}?location=${encodeURIComponent(town.id)}` : base;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{town ? `Weekly updates for ${town.name} | Newsbee` : "Weekly updates | Newsbee"}</title>
  </head>
  <body>
    <main>
      <header>
        <a class="brand" href={base}>Newsbee</a>
        <p>Your community, this week</p>
      </header>
      {town ? (
        <section aria-labelledby="signup-title">
          <h1 id="signup-title">Weekly updates for {town.name}</h1>
          <p>Stay connected with local stories, civic updates, and nearby events.</p>
          <SignupForm locationId={town.id} locationName={town.name} />
        </section>
      ) : <p role="alert">{error}</p>}
      <p><a href={backUrl}>{town ? `Back to ${town.name}` : "Find your neighborhood"}</a></p>
    </main>
  </body>
</html>
<style is:global>
  @font-face { font-family: "Chomsky"; src: url("/fonts/Chomsky.otf") format("opentype"); font-display: swap; }
  :root { --paper: #f5f0e4; --ink: #1c1a17; --muted: #5b554b; --rule: #2b2823; --accent: #7a1f1f; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #d9d2c3; color: var(--ink); font: 17px/1.6 Georgia, "Times New Roman", serif; }
  main { max-width: 40rem; margin: 2rem auto; padding: 2rem; background: var(--paper); text-align: center; box-shadow: 0 4px 20px rgb(0 0 0 / 0.12); }
  header { border-bottom: 4px double var(--rule); }
  header p { color: var(--muted); font-style: italic; }
  .brand { font: 4rem/1 "Chomsky", Georgia, serif; color: var(--ink); text-decoration: none; }
  h1 { font-size: 1.6rem; line-height: 1.3; }
  a { color: var(--accent); text-underline-offset: 0.2em; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 640px) { main { margin: 0; padding: 1.5rem 1rem; min-height: 100vh; } }
</style>
