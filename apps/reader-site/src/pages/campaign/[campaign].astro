---
import { campaigns, isCampaignSlug } from "../../lib/campaigns";

const { campaign } = Astro.params;
if (!isCampaignSlug(campaign)) return new Response("Campaign not found", { status: 404 });
const page = campaigns[campaign];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const adviserSignup = campaign === "high-school-journalism";
const measurementId = process.env.PUBLIC_GA_MEASUREMENT_ID ?? "";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.description} />
    <title>{page.title} | Newsbee</title>
  </head>
  <body data-campaign={campaign} data-measurement-id={/^G-[A-Z0-9]+$/.test(measurementId) ? measurementId : ""}>
    <header class="masthead"><a href={`${base}/`} aria-label="Newsbee home">Newsbee</a></header>
    <main>
      <section aria-labelledby="headline" class="pitch">
        <p class="audience">{page.audience}</p>
        <h1 id="headline">{page.title}</h1>
        <p class="dek">{page.description}</p>
        <figure class="workflow">
          <img src={`${base}/campaign/reporting-workflow.png`} alt="You gather interviews and notes while Newsbee gathers public sources. You choose the angle while Newsbee organizes the material. Newsbee drafts an article, newsletter, or video for you to review." fetchpriority="high" />
          <figcaption><span>Collect together</span><span>Organize with Newsbee</span><span>Direct and review</span></figcaption>
        </figure>
      </section>
      <section class="signup" aria-labelledby="signup-title">
        <h2 id="signup-title">{page.cta}</h2>
        <p class="prelaunch">Newsbee is building this now. Tell us what you’d use first.</p>
        {adviserSignup && <p>Students, share this page with your teacher or adviser so they can sign up for your class.</p>}
        <form id="campaign-signup" method="post" action={`${base}/api/campaign-signups`}>
          <fieldset disabled>
            <label>
              {adviserSignup ? "School email" : "Email"}
              <input name="email" type="email" autocomplete="email" maxlength="254" required />
            </label>
            <label>
              {page.contextLabel}
              <input name="context" type="text" maxlength="120" placeholder={page.contextExample} required />
            </label>
            <label>
              {page.roleLabel}
              <select name="role" required>
                <option value="">Choose your role</option>
                {page.roles.map((role) => <option>{role}</option>)}
              </select>
            </label>
            <label>
              {page.interestLabel}
              <select name="interest" required>
                <option value="">Choose one</option>
                {page.interests.map((interest) => <option>{interest}</option>)}
              </select>
            </label>
            {adviserSignup && (
              <label class="checkbox">
                <input name="adultAdviser" type="checkbox" required />
                I’m an adult signing up on behalf of a school or club.
              </label>
            )}
            <button type="submit">{page.cta}</button>
            <p class="contact-note">Newsbee may email you about early access and ask for feedback.</p>
          </fieldset>
        </form>
        <noscript><p>Enable JavaScript to use the signup form.</p></noscript>
        <p id="signup-error" role="alert" hidden></p>
        <p id="signup-success" role="status" tabindex="-1"></p>
      </section>
    </main>
  </body>
</html>

<script>
  import { campaignAttributionKeys } from "../../lib/campaigns";

  const { campaign, measurementId } = document.body.dataset;
  const attribution: Record<string, string> = {};
  const locationForAnalytics = new URL(window.location.pathname, window.location.origin);
  const params = new URLSearchParams(window.location.search);
  for (const key of campaignAttributionKeys) {
    const value = params.get(key);
    if (value && /^[a-z0-9][a-z0-9_. -]{0,99}$/i.test(value)) {
      attribution[key] = value;
      locationForAnalytics.searchParams.set(key, value);
    }
  }

  const queue: IArguments[] = [];
  function gtag(..._args: unknown[]) {
    queue.push(arguments);
  }

  if (measurementId) {
    Object.assign(window, { dataLayer: queue, gtag });
    gtag("js", new Date());
    gtag("config", measurementId, {
      send_page_view: false,
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
      page_location: locationForAnalytics.href,
      page_referrer: "",
    });
    const tag = document.createElement("script");
    tag.async = true;
    tag.src = "https://www.googletagmanager.com/gtag/js?id=" + measurementId;
    document.head.append(tag);
  }

  function track(event: string) {
    if (measurementId) gtag("event", event, { campaign_audience: campaign });
  }

  track("page_view");

  const form = document.querySelector<HTMLFormElement>("#campaign-signup")!;
  const fields = form.querySelector("fieldset")!;
  const error = document.querySelector<HTMLParagraphElement>("#signup-error")!;
  const success = document.querySelector<HTMLParagraphElement>("#signup-success")!;

  fields.disabled = false;
  form.addEventListener("focusin", () => track("campaign_signup_start"), { once: true });
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (fields.disabled) return;
    const answers = new FormData(form);
    fields.disabled = true;
    error.hidden = true;
    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...Object.fromEntries(answers),
          ...attribution,
          campaign,
          adultAdviser: answers.has("adultAdviser"),
        }),
      });
      const result = await response.json();
      if (!response.ok) {
        error.textContent = result.detail ?? "We couldn’t save your signup. Please try again.";
        error.hidden = false;
        return;
      }
      if (result.created) track("generate_lead");
      form.reset();
      form.hidden = true;
      success.textContent = result.created
        ? "Thanks. We’ve saved your interest in Newsbee."
        : "Thanks. You’re already on the list.";
      success.focus();
    } catch {
      error.textContent = "We couldn’t save your signup. Please try again.";
      error.hidden = false;
    } finally {
      fields.disabled = false;
    }
  });
</script>

<style>
  @font-face {
    font-family: Chomsky;
    src: url("/fonts/Chomsky.otf") format("opentype");
    font-display: swap;
  }
  :global(html) { background: #f8f4e9; color: #211f1a; }
  :global(body) { margin: 0 auto; max-width: 76rem; padding: 0 clamp(1.25rem, 5vw, 4.5rem); font-family: system-ui, sans-serif; }
  .masthead { border-bottom: 3px double #211f1a; padding: 1.25rem 0; }
  .masthead a { font: 2.5rem/1 Chomsky, Georgia, serif; color: inherit; text-decoration: none; }
  main { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; padding: clamp(2rem, 7vw, 7rem) 0; }
  .pitch { padding-top: 1.2rem; border-top: 6px solid #dcaa3e; }
  .audience { font-weight: 700; font-size: .85rem; margin: 0 0 1.3rem; }
  h1 { font: 700 clamp(2.7rem, 6.4vw, 6.1rem)/.98 Georgia, serif; letter-spacing: -.055em; margin: 0; }
  .dek { font: clamp(1.18rem, 2vw, 1.4rem)/1.55 Georgia, serif; max-width: 34rem; margin: 1.4rem 0 0; }
  .workflow { margin: 1.5rem 0 0; max-width: 34rem; overflow: hidden; border: 1px solid #d6cebb; background: #fffdf7; }
  .workflow img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: contain; }
  .workflow figcaption { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #d6cebb; padding: .65rem .25rem; text-align: center; font-size: .85rem; font-weight: 700; }
  .signup { background: #fffdf7; border: 1px solid #d6cebb; padding: clamp(1.15rem, 3vw, 2rem); }
  h2 { font: 700 1.85rem/1.15 Georgia, serif; margin: 0 0 1.1rem; }
  .prelaunch { margin: 0 0 1.2rem; line-height: 1.45; }
  fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 1rem; min-width: 0; }
  label { display: grid; gap: .4rem; font-size: .9rem; font-weight: 650; }
  input, select, button { font: inherit; }
  input, select { background: white; padding: .7rem; border: 1px solid #817969; border-radius: .25rem; color: inherit; min-width: 0; width: 100%; box-sizing: border-box; }
  .checkbox { display: flex; gap: .6rem; align-items: baseline; }
  .checkbox input { width: auto; margin: 0; }
  button { background: #f0c65f; color: #211f1a; border: 1px solid #967221; border-radius: .25rem; padding: .75rem; font-weight: 750; cursor: pointer; }
  button:hover { background: #f7d782; }
  button:disabled { opacity: .6; cursor: wait; }
  :is(input, select, button, a):focus-visible { outline: 2px solid #5b4100; outline-offset: 3px; }
  .contact-note { font-size: .8rem; line-height: 1.5; margin: 0; }
  #signup-error { color: #92251b; }
  #signup-success:empty { margin: 0; }
  @media (max-width: 720px) {
    main { grid-template-columns: 1fr; }
    .pitch { padding-top: .9rem; }
  }
</style>
